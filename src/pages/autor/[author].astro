---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { authorGroups, type Group } from "@/utils/filteredPages"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  return (await authorGroups()).map((group) => ({
    params: { author: group.slug },
    props: group,
  }))
}

type Props = Group<CollectionEntry<"timeline">>

const { slug, name, entries } = Astro.props
---

<FilteredTimeline label="Autor" name={name} entries={entries} base={`/autor/${slug}`} />
