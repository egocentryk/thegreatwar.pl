---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { yearPaths, type Group } from "@/utils/filteredPages"

// Later years of a long author list; the first year is on the main page.
export const getStaticPaths = yearPaths("author", "pl", "author")

const { group, year } = Astro.props as { group: Group; year: number }
---

<FilteredTimeline kind="author" group={group} year={year} />
