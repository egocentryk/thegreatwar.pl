---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { extraYears, categoryGroups, type Group } from "@/utils/filteredPages"
import type { CollectionEntry } from "astro:content"

// Later years of a long list (utils/filteredPages.ts); the first year is on
// the main page.
export async function getStaticPaths() {
  return (await categoryGroups()).flatMap((group) =>
    extraYears(group.entries, `/kategoria/${group.slug}`).map((year) => ({
      params: { category: group.slug, year: String(year) },
      props: { ...group, year },
    })),
  )
}

type Props = Group<CollectionEntry<"timeline">> & { year: number }

const { slug, name, entries, year } = Astro.props
---

<FilteredTimeline
  label="Kategoria"
  name={name}
  entries={entries}
  base={`/kategoria/${slug}`}
  year={year}
/>
