---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { categoryGroups, type Group } from "@/utils/filteredPages"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  return (await categoryGroups()).map((group) => ({
    params: { category: group.slug },
    props: group,
  }))
}

type Props = Group<CollectionEntry<"timeline">>

const { slug, name, entries } = Astro.props
---

<FilteredTimeline label="Kategoria" name={name} entries={entries} base={`/kategoria/${slug}`} />
