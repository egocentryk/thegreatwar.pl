---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { tagGroups, type Group } from "@/utils/filteredPages"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  return (await tagGroups()).map((group) => ({
    params: { tag: group.slug },
    props: group,
  }))
}

type Props = Group<CollectionEntry<"timeline">>

const { slug, name, entries } = Astro.props
---

<FilteredTimeline label="Tag" name={name} entries={entries} base={`/tag/${slug}`} />
