---
import { getCollection } from "astro:content"
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import {
  getTimelineMonthSlug,
  groupTimelineEntries,
  isPreWar,
} from "@/utils/groupTimelineEntries"
import { localEvents } from "@/i18n/local"
import { periodMeta } from "@/utils/periodMeta"
import { listPageLd } from "@/utils/jsonLd"

export async function getStaticPaths() {
  const entries = await getCollection("timeline", ({ data }) => !data.draft)
  const timelineByYear = groupTimelineEntries(entries)

  return timelineByYear.filter((yearGroup) => !isPreWar(yearGroup.year)).flatMap((yearGroup) =>
    yearGroup.months.map((monthGroup) => ({
      params: {
        year: String(yearGroup.year),
        month: monthGroup.slug,
      },
    })),
  )
}

const allTimeline = await getCollection("timeline", ({ data }) => !data.draft)
const timelineByYear = groupTimelineEntries(allTimeline)
const activeYear = Number(Astro.params.year)
const activeMonth = Astro.params.month ?? getTimelineMonthSlug(0)
const hasEnglish = (await localEvents("en")).some(
  (entry) =>
    entry.data.date.getUTCFullYear() === activeYear &&
    getTimelineMonthSlug(entry.data.date.getUTCMonth()) === activeMonth,
)
const activeGroup = timelineByYear.find(
  (yearGroup) => yearGroup.year === activeYear,
)
const activeMonthGroup = activeGroup?.months.find(
  (monthGroup) => monthGroup.slug === activeMonth,
)
const meta = periodMeta("pl", activeYear, activeMonthGroup?.entries ?? [], {
  monthLabel: activeMonthGroup?.label,
})
// Structured data: the month as a collection of its articles (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = listPageLd(Astro.site!, {
  lang: "pl",
  path: pagePath,
  name: meta.heading,
  description: meta.description,
  trail: [
    { name: "Oś czasu", path: "/timeline" },
    { name: String(activeYear), path: `/timeline/${activeYear}` },
  ],
  items: (activeMonthGroup?.entries ?? []).map((entry) => `/${entry.id}`),
})
---

<BaseLayout
  jsonLd={jsonLd}
  title={meta.title}
  description={meta.description}
  alternates={hasEnglish ? { en: `/en/timeline/${activeYear}/${activeMonth}` } : {}}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Oś czasu" count={allTimeline.length} />
    <TimelineArchive
      activeYear={activeYear}
      activeMonth={activeMonth}
      timelineByYear={timelineByYear}
      heading={meta.heading}
    />
  </section>
</BaseLayout>
