---
import { getCollection } from "astro:content"
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { groupTimelineEntries, isPreWar } from "@/utils/groupTimelineEntries"
import { localEvents, paths } from "@/i18n/local"
import { listPageLd } from "@/utils/jsonLd"
import yearIntros from "@/data/year-intros.json"

// "Droga do wojny": every article before 1914 on one page; the year menu
// shows it as "Przed wojną" (TimelineArchive.astro).
const allTimeline = await getCollection("timeline", ({ data }) => !data.draft)
const timelineByYear = groupTimelineEntries(allTimeline)
const eraEntries = allTimeline.filter((entry) => isPreWar(entry.data.date.getUTCFullYear()))
const eraYears = timelineByYear.filter((group) => isPreWar(group.year)).map((group) => group.year)
const span = eraYears.length ? `${eraYears[0]}–${eraYears.at(-1)}` : ""
const heading = `Droga do wojny ${span}`
const intro = (yearIntros as Record<string, { pl: string[]; en: string[] }>)["przed-wojna"]?.pl ?? []
const description = `Droga do I wojny światowej w ${eraEntries.length} artykułach z lat ${span}: sojusze, wyścig zbrojeń morskich, kryzysy marokańskie, wojny bałkańskie i polskie przygotowania do walki o niepodległość.`
const hasEnglish = (await localEvents("en")).some((entry) => isPreWar(entry.data.date.getUTCFullYear()))
const jsonLd = listPageLd(Astro.site!, {
  lang: "pl",
  path: paths("pl").era,
  name: heading,
  description,
  trail: [{ name: "Oś czasu", path: "/timeline" }],
  items: eraEntries.map((entry) => `/${entry.id}`),
})
---

<BaseLayout
  jsonLd={jsonLd}
  title={heading}
  description={description}
  alternates={hasEnglish ? { en: paths("en").era } : {}}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Oś czasu" count={allTimeline.length} />
    <TimelineArchive era timelineByYear={timelineByYear} heading={heading} intro={intro} />
  </section>
</BaseLayout>
