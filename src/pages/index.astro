---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Button from "@/components/Button.astro"
import Fronts from "@/components/Fronts.astro"
import OnThisDay from "@/components/OnThisDay.astro"
import PolishThread from "@/components/PolishThread.astro"
import RandomBattles from "@/components/RandomBattles.astro"
import RandomEvents from "@/components/RandomEvents.astro"
import ReadingPath from "@/components/ReadingPath.astro"
import Search from "@/components/Search.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import TurningPoints from "@/components/TurningPoints.astro"
import WarYears from "@/components/WarYears.astro"
import { SITE } from "@/site.config"

const allTimeline = await getCollection("timeline", ({ data }) => !data.draft)

const allBattles = await getCollection("battles", ({ data }) => !data.draft)
// Covered period, e.g. "VI 1914 – XII 1918", from the first and last entry.
const romanMonths = [
  "I",
  "II",
  "III",
  "IV",
  "V",
  "VI",
  "VII",
  "VIII",
  "IX",
  "X",
  "XI",
  "XII",
]
const firstDate = allTimeline.reduce(
  (min, e) => (e.data.date < min ? e.data.date : min),
  allTimeline[0].data.date,
)
const lastDate = allTimeline.reduce(
  (max, e) => (e.data.date > max ? e.data.date : max),
  allTimeline[0].data.date,
)
const monthLabel = (d: Date) => romanMonths[d.getUTCMonth()]
const coveredUntil =
  firstDate.getUTCFullYear() === lastDate.getUTCFullYear()
    ? `${monthLabel(firstDate)}–${monthLabel(lastDate)} ${lastDate.getUTCFullYear()}`
    : `${monthLabel(firstDate)} ${firstDate.getUTCFullYear()} – ${monthLabel(lastDate)} ${lastDate.getUTCFullYear()}`
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p
      class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs"
    >
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"
      ></span>
      {SITE.status}
    </p>

    <h1
      class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl"
    >
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      Chronologiczny zapis całego konfliktu z lat 1914–1918, od pierwszych
      kryzysów po jego zakończenie.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/timeline" variant="solid">Zobacz oś czasu →</Button>
      <Button href="#contact" variant="ghost">Napisz do nas</Button>
    </div>
  </section>

  <Search />

  <OnThisDay />

  <WarYears />

  <TurningPoints />

  <ReadingPath />

  <Fronts />

  <PolishThread />

  <RandomEvents />

  <RandomBattles />

  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="O projekcie" />
    <p class="font-display text-ink max-w-xl text-2xl leading-snug sm:text-3xl">
      Polska kronika Wielkiej Wojny, zapisana dzień po dniu.
    </p>
    <p class="text-ink-soft mt-6 max-w-xl">
      Opisujemy wydarzenia z lat 1914–1918 w takiej kolejności, w jakiej
      rozgrywały się naprawdę: bitwy, decyzje polityczne, rozkazy i losy ludzi.
      Każdy fakt sprawdzamy w kilku źródłach, a gdy się one różnią, piszemy o
      tym otwarcie. Szczególną uwagę poświęcamy ziemiom polskim, przez które
      przetoczyła się znaczna część walk na froncie wschodnim.
    </p>

    <dl class="border-line mt-8 grid max-w-xl grid-cols-[1fr_0.75fr_1.75fr] gap-4 border-t pt-6">
      <div>
        <dt class="text-ink-soft font-mono text-xs">Wydarzenia</dt>
        <dd class="font-display text-ink mt-1 text-2xl">
          {allTimeline.length}
        </dd>
      </div>
      <div>
        <dt class="text-ink-soft font-mono text-xs">Bitwy</dt>
        <dd class="font-display text-ink mt-1 text-2xl">{allBattles.length}</dd>
      </div>
      <div>
        <dt class="text-ink-soft font-mono text-xs">Opisany okres</dt>
        <dd class="font-display text-ink mt-1 text-2xl">{coveredUntil}</dd>
      </div>
    </dl>

    <a
      href="/about"
      class="text-signal mt-6 inline-block font-mono text-xs hover:underline"
    >
      Więcej o projekcie →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Porozmawiajmy" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Chcesz się z nami skontaktować?
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>
