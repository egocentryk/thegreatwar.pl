---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { frontEn } from "@/i18n"
import { frontGroups, frontGroupsEn, type Group } from "@/utils/filteredPages"
import { slugify } from "@/utils/slugify"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  return (await frontGroups()).map((group) => ({
    params: { front: group.slug },
    props: group,
  }))
}

type Props = Group<CollectionEntry<"timeline">>

const { slug, name, entries } = Astro.props
const hasEnglish = (await frontGroupsEn()).some((group) => group.name === name)
---

<FilteredTimeline
  label="Front"
  name={name}
  entries={entries}
  base={`/front/${slug}`}
  alternates={hasEnglish ? { en: `/en/front/${slugify(frontEn(name))}` } : undefined}
/>
