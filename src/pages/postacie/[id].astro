---
import { getCollection, render, type CollectionEntry } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { enUrlFor } from "@/i18n"
import CoffeeButton from "@/components/CoffeeButton.astro"
import PersonSidebar from "@/components/PersonSidebar.astro"
import ReportError from "@/components/ReportError.astro"
import Sources from "@/components/Sources.astro"
import SupportCard from "@/components/SupportCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import TimelineArchive from "@/components/TimelineArchive.astro"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"
import { getPeople, lifeYears, personByName } from "@/utils/people"
import { slugify } from "@/utils/slugify"
import { breadcrumbLd, personLd } from "@/utils/jsonLd"
import { groups } from "@/utils/filteredPages"

export async function getStaticPaths() {
  const people = await getPeople()
  return people.map((person) => ({
    params: { id: person.id },
    props: { person },
  }))
}

interface Props {
  person: CollectionEntry<"people">
}

const { person } = Astro.props
const enUrl = await enUrlFor("people", person.id)
const {
  name,
  summary,
  role,
  country,
  side,
  born,
  died,
  birthPlace,
  deathPlace,
  bornYearOnly,
  diedYearOnly,
  authors,
  tags,
} = person.data
const { Content } = await render(person)
// A person's own tag may be on no article, and then it has no tag page.
const tagPages = new Set((await groups("tag", "pl")).map((group) => group.slug))

const people = await getPeople()

// Battles where this person is listed among the commanders.
const commanded = (
  await getCollection("battles", ({ data }) => !data.draft)
)
  .filter((battle) =>
    battle.data.sides.some((s) =>
      s.commanders.some((c) => personByName(people, c)?.id === person.id),
    ),
  )
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())

// Articles that link or tag this person, battles whose text links them, and
// the people they appear with most (utils/related.ts).
const found = await personMentions(person.id)
const events = await eventsById("pl")
const mentions = found.articles.flatMap((id) => events.get(id) ?? [])
const mentionsByYear = groupTimelineEntries(mentions)
const capped = found.total > mentions.length
const commandedIds = new Set(commanded.map((battle) => battle.id))
const allBattles = await getCollection("battles", ({ data }) => !data.draft)
const mentionedBattles = allBattles
  .filter((battle) => found.battles.includes(battle.id) && !commandedIds.has(battle.id))
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
const coPeople = found.coPeople.flatMap(({ id, count }) => {
  const other = people.find((p) => p.id === id)
  return other ? [{ href: `/postacie/${id}`, name: other.data.name, count }] : []
})
// Facts for the sidebar infobox.
const facts = [
  { label: "Urodzony", value: `${bornYearOnly ? born.getUTCFullYear() : formatDate(born)}${birthPlace ? `, ${birthPlace}` : ""}` },
  { label: "Zmarł", value: `${diedYearOnly ? died.getUTCFullYear() : formatDate(died)}${deathPlace ? `, ${deathPlace}` : ""}` },
  { label: "Kraj", value: [country, side].filter(Boolean).join(" · ") },
  { label: "Rola", value: role },
]

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = [
  personLd(Astro.site!, { ...person.data, lang: "pl", path: pagePath }),
  breadcrumbLd(Astro.site!, [
    { name: "Strona główna", path: "/" },
    { name: "Postacie", path: "/postacie" },
    { name, path: pagePath },
  ]),
]
import { listUrl } from "@/utils/filteredPages"
import { eventsById, personMentions } from "@/utils/related"
---

<BaseLayout
  jsonLd={jsonLd}
  title={`${name} (${lifeYears(person)})`}
  description={summary}
  alternates={{ en: enUrl }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-6xl px-6">
      <a
        href="/postacie"
        class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
      >
        ← Wszystkie postacie
      </a>

      <p
        class="text-signal mt-6 -mb-3 font-mono text-[10px] tracking-[0.2em] uppercase"
      >
        {country} · {side}
      </p>

      <h1
        class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl"
      >
        {name}
      </h1>
      <p class="text-ink-soft mt-3 max-w-2xl">{role}</p>

      {/* Wide screens: the facts move into the sidebar; authors and tags stay
          here in one line. */}
      <dl class="border-line text-ink-soft mt-6 hidden flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs lg:flex">
        <div>
          <dt class="inline">{authors.length > 1 ? "Autorzy: " : "Autor: "}</dt>
          <dd class="inline">
            {authors.map((author, index) => (
              <>
                {index > 0 && ", "}
                <a href={`/autor/${slugify(author)}`} class="text-ink hover:text-signal transition-colors">{author}</a>
              </>
            ))}
          </dd>
        </div>
        {tags.length > 0 && (
          <div>
            <dt class="inline">Tagi: </dt>
            <dd class="inline">
              {tags.map((tag, index) => (
                <>
                  {index > 0 && ", "}
                  {tagPages.has(slugify(tag)) ? (
                    <a href={`/tag/${slugify(tag)}`} class="text-ink hover:text-signal transition-colors">{tag}</a>
                  ) : (
                    tag
                  )}
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>

      <dl
        class="border-line text-ink-soft mt-6 grid gap-x-6 gap-y-3 border-y py-4 font-mono text-xs sm:grid-cols-[8rem_1fr] lg:hidden"
      >
        <dt>Urodzony:</dt>
        <dd class="text-ink">
          {bornYearOnly ? born.getUTCFullYear() : formatDate(born)}{birthPlace && `, ${birthPlace}`}
        </dd>
        <dt>Zmarł:</dt>
        <dd class="text-ink">
          {diedYearOnly ? died.getUTCFullYear() : formatDate(died)}{deathPlace && `, ${deathPlace}`}
        </dd>
        <dt>{authors.length > 1 ? "Autorzy:" : "Autor:"}</dt>
        <dd>
          {
            authors.map((author, index) => (
              <>
                {index > 0 && ", "}
                <a
                  href={`/autor/${slugify(author)}`}
                  class="text-ink hover:text-signal transition-colors"
                >
                  {author}
                </a>
              </>
            ))
          }
        </dd>
        {
          tags.length > 0 && (
            <>
              <dt>Tagi:</dt>
              <dd>
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ", "}
                    {tagPages.has(slugify(tag)) ? (
                      <a
                        href={`/tag/${slugify(tag)}`}
                        class="text-ink hover:text-signal transition-colors"
                      >
                        {tag}
                      </a>
                    ) : (
                      tag
                    )}
                  </>
                ))}
              </dd>
            </>
          )
        }
      </dl>

      <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0">
            <CoffeeButton class="lg:hidden" />
            <Content />
          </div>

          <Sources sources={person.data.sources} />
          <ReportError title={name} />
          <div class="lg:hidden">
            <SupportCard />
          </div>
        </div>

        <PersonSidebar
          facts={facts}
          battles={commanded.map((battle) => ({
            href: `/bitwy/${battle.id}`,
            title: battle.data.title,
            when: formatDateRange(battle.data.startDate, battle.data.endDate),
          }))}
          coPeople={coPeople}
        />
      </div>

      {
        commanded.length > 0 && (
          <section id="dowodzil" class="mt-16">
            <SectionHeading eyebrow="Dowodził w bitwach" count={commanded.length} />
            <ul class="border-line border-t">
              {commanded.map((battle) => (
                <li class="border-line hover:border-signal border-b transition-colors">
                  <a
                    href={`/bitwy/${battle.id}`}
                    class="group grid gap-1 py-4 sm:grid-cols-[12rem_1fr] sm:gap-4"
                  >
                    <span class="text-ink-soft font-mono text-xs leading-6">
                      {formatDateRange(battle.data.startDate, battle.data.endDate)}
                    </span>
                    <span class="min-w-0">
                      <span class="text-ink group-hover:text-signal block transition-colors">
                        {battle.data.title}
                      </span>
                      <span class="text-ink-soft mt-1 block text-xs leading-5">
                        {battle.data.front}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        mentionedBattles.length > 0 && (
          <section class="mt-16">
            <SectionHeading eyebrow="W opisach bitew" count={mentionedBattles.length} />
            <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
              {mentionedBattles.map((battle) => (
                <li>
                  <a href={`/bitwy/${battle.id}`} class="text-ink hover:text-signal transition-colors">
                    {battle.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        coPeople.length > 0 && (
          <section class="mt-16 lg:hidden">
            <SectionHeading eyebrow="Najczęściej obok" />
            <p class="text-ink-soft -mt-4 mb-4 text-sm">Postacie, które pojawiają się w tych samych wydarzeniach.</p>
            <ul class="flex flex-wrap gap-2">
              {coPeople.map((other) => (
                <li>
                  <a
                    href={other.href}
                    class="border-line hover:border-signal hover:text-signal text-ink inline-flex items-baseline gap-2 rounded-sm border px-3 py-1.5 text-sm transition-colors"
                  >
                    {other.name}
                    <span class="text-ink-soft font-mono text-[10px]">{other.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        mentions.length > 0 && (
          <section class="mt-16">
            <SectionHeading eyebrow="Na osi czasu" count={found.total} />
            {capped && (
              <p class="text-ink-soft -mt-4 mb-4 text-sm">
                {mentions.length} najważniejszych z {found.total} wydarzeń.{" "}
                {found.tag && (
                  <a href={listUrl("tag", "pl", found.tag.name)} class="text-signal hover:underline">
                    Wszystkie z tagiem „{found.tag.name}” ({found.tag.count}) →
                  </a>
                )}
              </p>
            )}
            <TimelineArchive
              timelineByYear={mentionsByYear}
              renderAllYears={true}
              showYearNav={false}
              showBackLink={false}
            />
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
