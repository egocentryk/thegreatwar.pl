---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { enUrlFor } from "@/i18n"
import Button from "@/components/Button.astro"
import ArticleSidebar from "@/components/ArticleSidebar.astro"
import CoffeeButton from "@/components/CoffeeButton.astro"
import GlossaryMarks from "@/components/GlossaryMarks.astro"
import PersonPreviews from "@/components/PersonPreviews.astro"
import { termsIn } from "@/utils/glossary"
import ArticleFigure from "@/components/ArticleFigure.astro"
import InBrief from "@/components/InBrief.astro"
import { articleImage } from "@/utils/articleImages"
import ReportError from "@/components/ReportError.astro"
import SeriesBox from "@/components/SeriesBox.astro"
import VoiceBox from "@/components/VoiceBox.astro"
import ReadStatus from "@/components/ReadStatus.astro"
import TopicBox from "@/components/TopicBox.astro"
import Sources from "@/components/Sources.astro"
import SupportCard from "@/components/SupportCard.astro"
import { formatDate } from "@/utils/formatDate"
import { slugify } from "@/utils/slugify"
import { compareTimelineEntries, eraOf } from "@/utils/groupTimelineEntries"
import { paths } from "@/i18n/local"
import { articleLd, breadcrumbLd } from "@/utils/jsonLd"
import { listUrl } from "@/utils/filteredPages"
import { pageEntities } from "@/utils/pageEntities"

type AssetImage = {
  src: string
  width: number
  height: number
  format:
    "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif" | "apng"
}

const articleImages = import.meta.glob<{ default: AssetImage }>(
  "../assets/images/*",
  { eager: true },
)

export async function getStaticPaths() {
  const entries = (
    await getCollection("timeline", ({ data }) => !data.draft)
  ).sort(compareTimelineEntries)
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: entries[index - 1],
      next: entries[index + 1],
    },
  }))
}

interface Props {
  entry: CollectionEntry<"timeline">
  previous?: CollectionEntry<"timeline">
  next?: CollectionEntry<"timeline">
}

const { entry, previous, next } = Astro.props
const enUrl = await enUrlFor("timeline", entry.id)
const {
  title,
  summary,
  category,
  front,
  date,
  authors,
  tags,
  url,
  repo,
  headerImage,
  milestone,
  battle,
} = entry.data
const battleEntry = battle ? await getEntry(battle) : undefined
const { Content } = await render(entry)

const formattedDate = formatDate(date)
const headerImageAsset = headerImage
  ? articleImages[`../assets/images/${headerImage}`]?.default
  : undefined

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const entities = await pageEntities(Astro.site!, "pl", {
  body: entry.body ?? "",
  battleId: battle?.id,
  tags,
})
const jsonLd = [
  articleLd(Astro.site!, {
    ...entities,
    lang: "pl",
    path: pagePath,
    title,
    summary,
    date,
    authors,
    tags,
    image: (headerImageAsset ?? articleImage(entry.id)?.asset)?.src,
  }),
  breadcrumbLd(Astro.site!, [
    { name: "Strona główna", path: "/" },
    { name: "Oś czasu", path: "/timeline" },
    {
      name: ((era) => (era ? { pre: "Przed wojną", post: "Po wojnie" }[era] : String(date.getUTCFullYear())))(eraOf(date.getUTCFullYear())),
      path: paths("pl").year(date.getUTCFullYear()),
    },
    { name: title, path: pagePath },
  ]),
]
import RelatedEvents from "@/components/RelatedEvents.astro"
const ogArticle = {
  section: category,
  tags,
  authors: authors.map((name) => listUrl("author", "pl", name)),
}
// Glossary terms used in the text (marked in the browser).
const glossaryTerms = termsIn(entry.body ?? "", "pl", entry.id)
---

<BaseLayout
  jsonLd={jsonLd}
  article={ogArticle}
  title={`${title} (${formattedDate})`}
  description={summary}
  image={(headerImageAsset ?? articleImage(entry.id)?.asset)?.src}
  alternates={{ en: enUrl }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-6xl px-6">
      <a
        href="/timeline"
        class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
      >
        ← Oś czasu
      </a>

      {
        milestone && (
          <p class="text-signal mt-6 -mb-3 flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] uppercase">
            <span
              aria-hidden="true"
              class="bg-signal ring-signal/25 ml-1 size-2 rounded-full ring-4"
            />
            Kluczowe wydarzenie
          </p>
        )
      }

      <h1
        class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl"
      >
        {title}
      </h1>

    {
      headerImageAsset && (
        <div class="mt-8 overflow-hidden rounded-sm">
          <Image
            src={headerImageAsset}
            alt={title}
            class="h-auto w-full object-cover"
            sizes="(min-width: 1024px) 672px, 100vw"
          />
        </div>
      )
    }

      <dl
        class="border-line text-ink-soft mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs"
      >
        <div>
          <dt class="inline">Kategoria: </dt><dd class="inline">
            <a
              href={`/kategoria/${slugify(category)}`}
              class="text-ink hover:text-signal transition-colors"
            >
              {category}
            </a>
          </dd>
        </div>
        {
          front && (
            <div>
              <>
                <dt class="inline">Front: </dt>
                <dd class="inline">{front}</dd>
              </>
            </div>
          )
        }
        <div>
          <dt class="inline">Data: </dt><dd class="inline">{formattedDate}</dd>
        </div>
        <div>
          <dt class="inline">{authors.length > 1 ? "Autorzy: " : "Autor: "}</dt>
          <dd class="inline">
            {
              authors.map((name, index) => (
                <>
                  {index > 0 && ", "}
                  <a
                    href={`/autor/${slugify(name)}`}
                    class="text-ink hover:text-signal transition-colors"
                  >
                    {name}
                  </a>
                </>
              ))
            }
          </dd>
        </div>
        {
          battleEntry && (
            <div>
              <dt class="inline">Bitwa: </dt>
              <dd class="inline">
                <a
                  href={`/bitwy/${battleEntry.id}`}
                  class="text-ink hover:text-signal transition-colors"
                >
                  {battleEntry.data.title}
                </a>
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt class="inline">Tagi: </dt>
              <dd class="inline">
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ", "}
                    <a
                      href={`/tag/${slugify(tag)}`}
                      class="text-ink hover:text-signal transition-colors"
                    >
                      {tag}
                    </a>
                  </>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

        {/* Text on the left; on wide screens the right column holds the date,
            "W skrócie", people, the battle and a support card that stays in
            view, so the same blocks in the text column show only on smaller
            screens. */}
      <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <ArticleFigure ref={entry.id} />
          <div class="lg:hidden">
            <InBrief points={entry.data.brief} />
          </div>

          <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0" data-glossary-scope>
            <CoffeeButton class="lg:hidden" />
            <Content />
            <GlossaryMarks terms={glossaryTerms} lang="pl" />
            <PersonPreviews body={entry.body ?? ""} lang="pl" />
          </div>

          <ReadStatus id={entry.id} body={entry.body ?? ""} />
          <VoiceBox ref={entry.id} />

          <div class="lg:hidden">
            <TopicBox ref={entry.id} />
            <SeriesBox ref={entry.id} />
          </div>
          <Sources sources={entry.data.sources} />
          <ReportError title={title} />
          <div class="lg:hidden">
            <SupportCard />
          </div>

          <RelatedEvents id={entry.id} />

          {
            (previous || next) && (
              <nav
                aria-label="Sąsiednie wydarzenia"
                class="border-line mt-12 grid gap-4 border-t pt-6 sm:grid-cols-2"
              >
                {previous ? (
                  <a
                    href={`/${previous.id}`}
                    rel="prev"
                    class="group border-line hover:border-signal block rounded-sm border p-4 transition-colors"
                  >
                    <span class="text-ink-soft block font-mono text-[11px]">
                      ← Poprzednie wydarzenie · {formatDate(previous.data.date)}
                    </span>
                    <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg transition-colors">
                      {previous.data.title}
                    </span>
                  </a>
                ) : (
                  <span class="hidden sm:block" />
                )}
                {next && (
                  <a
                    href={`/${next.id}`}
                    rel="next"
                    class="group border-line hover:border-signal block rounded-sm border p-4 text-right transition-colors"
                  >
                    <span class="text-ink-soft block font-mono text-[11px]">
                      {formatDate(next.data.date)} · Następne wydarzenie →
                    </span>
                    <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg transition-colors">
                      {next.data.title}
                    </span>
                  </a>
                )}
              </nav>
            )
          }

          <div class="mt-10 flex flex-wrap gap-3">
            {
              url && (
                <Button href={url} variant="solid">
                  Visit live →
                </Button>
              )
            }
            {
              repo && (
                <Button href={repo} variant="ghost">
                  View source
                </Button>
              )
            }
          </div>
        </div>

        <ArticleSidebar
          class="pt-10"
          id={entry.id}
          date={date}
          body={entry.body ?? ""}
          battleId={battle?.id}
          brief={entry.data.brief}
          previous={previous && { href: `/${previous.id}`, title: previous.data.title, date: previous.data.date }}
          next={next && { href: `/${next.id}`, title: next.data.title, date: next.data.date }}
        />
      </div>
    </div>
  </article>
</BaseLayout>
