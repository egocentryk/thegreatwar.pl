---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Button from "@/components/Button.astro"
import { formatDate } from "@/utils/formatDate"
import { slugify } from "@/utils/slugify"

type AssetImage = {
  src: string
  width: number
  height: number
  format:
    "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif" | "apng"
}

const articleImages = import.meta.glob<{ default: AssetImage }>(
  "../assets/images/*",
  { eager: true },
)

export async function getStaticPaths() {
  const entries = await getCollection("timeline", ({ data }) => !data.draft)
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"timeline">
}

const { entry } = Astro.props
const {
  title,
  summary,
  category,
  front,
  date,
  authors,
  tags,
  url,
  repo,
  headerImage,
  milestone,
  battle,
} = entry.data
const battleEntry = battle ? await getEntry(battle) : undefined
const { Content } = await render(entry)

const formattedDate = formatDate(date)
const headerImageAsset = headerImage
  ? articleImages[`../assets/images/${headerImage}`]?.default
  : undefined
---

<BaseLayout title={title} description={summary} image={headerImageAsset?.src}>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-3xl px-6">
      <a
        href="/timeline"
        class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
      >
        ← Oś czasu
      </a>

      {
        milestone && (
          <p class="text-signal mt-6 -mb-3 flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] uppercase">
            <span
              aria-hidden="true"
              class="bg-signal ring-signal/25 ml-1 size-2 rounded-full ring-4"
            />
            Kluczowe wydarzenie
          </p>
        )
      }

      <h1
        class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl"
      >
        {title}
      </h1>
    </div>

    {
      headerImageAsset && (
        <div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-sm">
          <Image
            src={headerImageAsset}
            alt={title}
            class="h-auto w-full object-cover"
            sizes="(min-width: 1024px) 1024px, 100vw"
          />
        </div>
      )
    }

    <div class="mx-auto max-w-3xl px-6">
      <dl
        class="border-line text-ink-soft mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs"
      >
        <div>
          <dt class="inline">Kategoria:</dt><dd class="inline">
            <a
              href={`/kategoria/${slugify(category)}`}
              class="text-ink hover:text-signal transition-colors"
            >
              {category}
            </a>
          </dd>
        </div>
        {
          front && (
            <div>
              <>
                <dt class="inline">Front: </dt>
                <dd class="inline">{front}</dd>
              </>
            </div>
          )
        }
        <div>
          <dt class="inline">Data:</dt><dd class="inline">{formattedDate}</dd>
        </div>
        <div>
          <dt class="inline">{authors.length > 1 ? "Autorzy: " : "Autor: "}</dt>
          <dd class="inline">
            {
              authors.map((name, index) => (
                <>
                  {index > 0 && ", "}
                  <a
                    href={`/autor/${slugify(name)}`}
                    class="text-ink hover:text-signal transition-colors"
                  >
                    {name}
                  </a>
                </>
              ))
            }
          </dd>
        </div>
        {
          battleEntry && (
            <div>
              <dt class="inline">Bitwa: </dt>
              <dd class="inline">
                <a
                  href={`/bitwy/${battleEntry.id}`}
                  class="text-ink hover:text-signal transition-colors"
                >
                  {battleEntry.data.title}
                </a>
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt class="inline">Tagi: </dt>
              <dd class="inline">
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ", "}
                    <a
                      href={`/tag/${slugify(tag)}`}
                      class="text-ink hover:text-signal transition-colors"
                    >
                      {tag}
                    </a>
                  </>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0">
        <div class="not-prose float-right mb-2 ml-4 sm:mb-3 sm:ml-6">
          <Button
            href="https://buymeacoffee.com/thegreatwar"
            variant="accent"
            size="responsive"
            target="_blank"
            rel="noopener noreferrer"
          >
            Kup nam kawę
          </Button>
        </div>
        <Content />
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          url && (
            <Button href={url} variant="solid">
              Visit live →
            </Button>
          )
        }
        {
          repo && (
            <Button href={repo} variant="ghost">
              View source
            </Button>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
