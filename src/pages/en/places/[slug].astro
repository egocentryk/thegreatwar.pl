---
import PlacePage from "@/components/PlacePage.astro"
import { localPlaces, type LocalPlace } from "@/utils/places"

export async function getStaticPaths() {
  return (await localPlaces("en")).map((place) => ({ params: { slug: place.slug }, props: { place } }))
}

interface Props {
  place: LocalPlace
}

const { place } = Astro.props
---

<PlacePage place={place} lang="en" />
