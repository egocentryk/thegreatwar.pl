---
// English person page: /en/people/<english-slug>.
import { Image } from "astro:assets"
import { getCollection, getEntry, render } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import CoffeeButton from "@/components/CoffeeButton.astro"
import GlossaryMarks from "@/components/GlossaryMarks.astro"
import PersonPreviews from "@/components/PersonPreviews.astro"
import { termsIn } from "@/utils/glossary"
import PersonSidebar from "@/components/PersonSidebar.astro"
import ReportError from "@/components/ReportError.astro"
import Sources from "@/components/Sources.astro"
import SupportCard from "@/components/SupportCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import TimelineArchive from "@/components/TimelineArchive.astro"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { enUrlFor, frontEn, plPath, rewriteEnHtml, sideEn } from "@/i18n"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"
import { getPeople, lifeYears, personByName } from "@/utils/people"
import { breadcrumbLd, personLd } from "@/utils/jsonLd"

export async function getStaticPaths() {
  const people = await getCollection("peopleEn", ({ data }) => !data.draft)
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }))
}

const { person } = Astro.props
const source = (await getEntry(person.data.source))!
const { name, summary, role, country, birthPlace, deathPlace } = person.data
const { born, died, bornYearOnly, diedYearOnly, side, photo, authors } = source.data
await render(person)
const html = await rewriteEnHtml(person.rendered?.html ?? "")
const fmt = (d: Date) => formatDate(d, "long", undefined, "en-GB")

// Battles where this person commanded (English page if translated, else Polish).
const people = await getPeople()
const commanded = await Promise.all(
  (await getCollection("battles", ({ data }) => !data.draft))
    .filter((b) => b.data.sides.some((s) => s.commanders.some((c) => personByName(people, c)?.id === source.id)))
    .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
    .map(async (b) => {
      const href = await enUrlFor("battles", b.id)
      const en = href ? await getEntry("battlesEn", href.split("/").pop()!) : undefined
      return { href: href ?? plPath.battles(b.id), title: en?.data.title ?? b.data.title, pl: !en, battle: b }
    }),
)

// Articles that link or tag this person, battles whose text links them, and
// the people they appear with most (utils/related.ts); English pages where
// translated, else Polish.
const found = await personMentions(source.id)
const events = await eventsById("en")
const mentions = found.articles.flatMap((id) => events.get(id) ?? [])
const mentionsByYear = groupTimelineEntries(mentions, "en-GB")
const capped = found.total > mentions.length
const commandedIds = new Set(commanded.map((c) => c.battle.id))
const mentionedBattles = await Promise.all(
  (await getCollection("battles", ({ data }) => !data.draft))
    .filter((b) => found.battles.includes(b.id) && !commandedIds.has(b.id))
    .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
    .map(async (b) => {
      const href = await enUrlFor("battles", b.id)
      const en = href ? await getEntry("battlesEn", href.split("/").pop()!) : undefined
      return { href: href ?? plPath.battles(b.id), title: en?.data.title ?? b.data.title, pl: !en }
    }),
)
const coPeople = await Promise.all(
  found.coPeople.flatMap(({ id, count }) => {
    const other = people.find((p) => p.id === id)
    if (!other) return []
    return [
      (async () => {
        const href = await enUrlFor("people", id)
        const en = href ? await getEntry("peopleEn", href.split("/").pop()!) : undefined
        return { href: href ?? plPath.people(id), name: en?.data.name ?? other.data.name, pl: !en, count, photo: other.data.photo?.src }
      })(),
    ]
  }),
)

// Facts for the sidebar infobox.
const facts = [
  { label: "Born", value: `${bornYearOnly ? born.getUTCFullYear() : fmt(born)}${birthPlace ? `, ${birthPlace}` : ""}` },
  { label: "Died", value: `${diedYearOnly ? died.getUTCFullYear() : fmt(died)}${deathPlace ? `, ${deathPlace}` : ""}` },
  { label: "Country", value: [country, sideEn(side)].filter(Boolean).join(" · ") },
  { label: "Role", value: role },
]

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = [
  personLd(Astro.site!, {
    ...source.data,
    name,
    summary,
    role,
    country,
    birthPlace,
    deathPlace,
    lang: "en",
    path: pagePath,
    image: photo ? `/og/postacie/${source.id}.jpg` : undefined,
  }),
  breadcrumbLd(Astro.site!, [
    { name: "Home", path: "/en" },
    { name: "People", path: "/en/people" },
    { name, path: pagePath },
  ]),
]
import { tagEn } from "@/i18n/data-en"
import { listUrl } from "@/utils/filteredPages"
import { eventsById, personMentions } from "@/utils/related"
// Glossary terms used in the text (marked in the browser).
const glossaryTerms = termsIn(person.body ?? "", "en", `postacie/${source.id}`)
---

<BaseLayout
  jsonLd={jsonLd}
  title={`${name} (${lifeYears(source)})`}
  description={summary}
  image={photo ? `/og/postacie/${source.id}.jpg` : undefined}
  lang="en"
  alternates={{ pl: plPath.people(source.id) }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/en/people" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
        ← All people
      </a>

      <div class="flex items-start justify-between gap-6">
        <div class="min-w-0">
          <p class="text-signal mt-6 -mb-3 font-mono text-[10px] tracking-[0.2em] uppercase">
            {country} · {sideEn(side)}
          </p>
          <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">{name}</h1>
          <p class="text-ink-soft mt-3 max-w-2xl">{role}</p>
        </div>
        {
          photo && (
            <Image
              src={photo.src}
              alt={name}
              widths={[112, 160, 224, 320]}
              sizes="(min-width: 640px) 160px, 112px"
              loading="eager"
              class="border-line mt-6 aspect-[3/4] w-28 shrink-0 rounded-sm border object-cover sm:w-40 lg:hidden"
            />
          )
        }
      </div>

      {/* Wide screens: the facts move into the sidebar; the authors stay here. */}
      <dl class="border-line text-ink-soft mt-6 hidden flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs lg:flex">
        <div>
          <dt class="inline">{authors.length > 1 ? "Authors: " : "Author: "}</dt>
          <dd class="text-ink inline">{authors.join(", ")}</dd>
        </div>
      </dl>

      <dl class="border-line text-ink-soft mt-6 grid gap-x-6 gap-y-3 border-y py-4 font-mono text-xs sm:grid-cols-[8rem_1fr] lg:hidden">
        <dt>Born:</dt>
        <dd class="text-ink">{bornYearOnly ? born.getUTCFullYear() : fmt(born)}{birthPlace && `, ${birthPlace}`}</dd>
        <dt>Died:</dt>
        <dd class="text-ink">{diedYearOnly ? died.getUTCFullYear() : fmt(died)}{deathPlace && `, ${deathPlace}`}</dd>
        <dt>{authors.length > 1 ? "Authors:" : "Author:"}</dt>
        <dd class="text-ink">{authors.join(", ")}</dd>
        {
          photo && (
            <>
              <dt>Photo:</dt>
              <dd>
                <a href={photo.source} class="text-ink hover:text-signal transition-colors" rel="noopener">
                  {photo.credit}, {photo.license}, Wikimedia Commons
                </a>
              </dd>
            </>
          )
        }
      </dl>

      <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0" data-glossary-scope>
            <CoffeeButton lang="en" class="lg:hidden" />
            <Fragment set:html={html} />
            <GlossaryMarks terms={glossaryTerms} lang="en" />
            <PersonPreviews body={person.body ?? ""} lang="en" />
          </div>

          <Sources sources={source.data.sources} lang="en" />
          <ReportError title={name} lang="en" />
          <div class="lg:hidden">
            <SupportCard lang="en" />
          </div>
        </div>

        <PersonSidebar
          lang="en"
          name={name}
          photo={photo}
          facts={facts}
          battles={commanded.map((c) => ({
            href: c.href,
            title: c.title,
            when: formatDateRange(c.battle.data.startDate, c.battle.data.endDate, "en-GB"),
            pl: c.pl,
          }))}
          coPeople={coPeople}
        />
      </div>

      {
        commanded.length > 0 && (
          <section id="commanded" class="mt-16">
            <SectionHeading eyebrow="Commanded in battles" count={commanded.length} />
            <ul class="border-line border-t">
              {commanded.map((c) => (
                <li class="border-line hover:border-signal border-b transition-colors">
                  <a href={c.href} hreflang={c.pl ? "pl" : undefined} class="group grid gap-1 py-4 sm:grid-cols-[12rem_1fr] sm:gap-4">
                    <span class="text-ink-soft font-mono text-xs leading-6">
                      {formatDateRange(c.battle.data.startDate, c.battle.data.endDate, "en-GB")}
                    </span>
                    <span class="min-w-0">
                      <span class="text-ink group-hover:text-signal block transition-colors">
                        {c.title}
                        {c.pl && <span class="lang-mark">(PL)</span>}
                      </span>
                      <span class="text-ink-soft mt-1 block text-xs leading-5">
                        {frontEn(c.battle.data.front)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        mentionedBattles.length > 0 && (
          <section class="mt-16">
            <SectionHeading eyebrow="Mentioned in battles" count={mentionedBattles.length} />
            <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
              {mentionedBattles.map((b) => (
                <li>
                  <a href={b.href} hreflang={b.pl ? "pl" : undefined} class="text-ink hover:text-signal transition-colors">
                    {b.title}
                    {b.pl && <span class="lang-mark">(PL)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        coPeople.length > 0 && (
          <section class="mt-16 lg:hidden">
            <SectionHeading eyebrow="Often appears with" />
            <p class="text-ink-soft -mt-4 mb-4 text-sm">People who appear in the same events.</p>
            <ul class="flex flex-wrap gap-2">
              {coPeople.map((other) => (
                <li>
                  <a
                    href={other.href}
                    hreflang={other.pl ? "pl" : undefined}
                    class="border-line hover:border-signal hover:text-signal text-ink inline-flex items-baseline gap-2 rounded-sm border px-3 py-1.5 text-sm transition-colors"
                  >
                    {other.name}
                    {other.pl && <span class="lang-mark">(PL)</span>}
                    <span class="text-ink-soft font-mono text-[10px]">{other.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        mentions.length > 0 && (
          <section class="mt-16">
            <SectionHeading eyebrow="On the timeline" count={found.total} />
            {capped && (
              <p class="text-ink-soft -mt-4 mb-4 text-sm">
                The {mentions.length} most important of {found.total} events.{" "}
                {found.tag && (
                  <a href={listUrl("tag", "en", found.tag.name)} class="text-signal hover:underline">
                    All tagged “{tagEn(found.tag.name)}” ({found.tag.count}) →
                  </a>
                )}
              </p>
            )}
            <TimelineArchive
              timelineByYear={mentionsByYear}
              renderAllYears={true}
              showYearNav={false}
              showBackLink={false}
              lang="en"
            />
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
