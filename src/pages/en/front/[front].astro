---
import FilteredTimeline from "@/components/FilteredTimeline.astro"
import { frontEn } from "@/i18n"
import type { LocalEvent } from "@/i18n/local"
import { frontGroupsEn, type Group } from "@/utils/filteredPages"
import { slugify } from "@/utils/slugify"

export async function getStaticPaths() {
  return (await frontGroupsEn()).map((group) => ({
    params: { front: group.slug },
    props: group,
  }))
}

// `name` is the Polish front name (the key); the page shows frontEn(name).
type Props = Group<LocalEvent>

const { slug, name, entries } = Astro.props
---

<FilteredTimeline
  label="Front"
  name={frontEn(name)}
  entries={entries}
  base={`/en/front/${slug}`}
  lang="en"
  alternates={{ pl: `/front/${slugify(name)}` }}
/>
