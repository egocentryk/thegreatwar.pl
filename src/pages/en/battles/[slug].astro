---
// English battle page: /en/battles/<english-slug>.
import { getCollection, getEntry, render } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import BattleSidebar from "@/components/BattleSidebar.astro"
import CoffeeButton from "@/components/CoffeeButton.astro"
import GlossaryMarks from "@/components/GlossaryMarks.astro"
import PersonPreviews from "@/components/PersonPreviews.astro"
import { termsIn } from "@/utils/glossary"
import ArticleFigure from "@/components/ArticleFigure.astro"
import InBrief from "@/components/InBrief.astro"
import { articleImage } from "@/utils/articleImages"
import ReportError from "@/components/ReportError.astro"
import BattleFamily from "@/components/BattleFamily.astro"
import SeriesBox from "@/components/SeriesBox.astro"
import TopicBox from "@/components/TopicBox.astro"
import Sources from "@/components/Sources.astro"
import SupportCard from "@/components/SupportCard.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import TimelineArchive from "@/components/TimelineArchive.astro"
import { BATTLE_PHASES } from "@/data/battlePhases"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { enUrlFor, frontEn, plPath, rewriteEnHtml } from "@/i18n"
import { PHASES_EN, tagEn } from "@/i18n/data-en"
import { listUrl } from "@/utils/filteredPages"
import { pageEntities } from "@/utils/pageEntities"
import { localEvents, paths } from "@/i18n/local"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"
import { getPeople, personByName } from "@/utils/people"
import { battleLd, breadcrumbLd } from "@/utils/jsonLd"

export async function getStaticPaths() {
  const battles = await getCollection("battlesEn", ({ data }) => !data.draft)
  return battles.map((battle) => ({ params: { slug: battle.id }, props: { battle } }))
}

const { battle } = Astro.props
const source = (await getEntry(battle.data.source))!
const { title, summary, location, sides, result } = battle.data
const { front, phase, startDate, endDate, authors, milestone } = source.data
await render(battle)
const html = await rewriteEnHtml(battle.rendered?.html ?? "")
const range = formatDateRange(startDate, endDate, "en-GB")

// Commanders: the English list is in the same order as the Polish one, so the
// Polish name finds the person page.
const people = await getPeople()
const commanderLinks = await Promise.all(
  sides.map((side, s) =>
    Promise.all(
      side.commanders.map(async (name, c) => {
        const plName = source.data.sides[s]?.commanders[c] ?? name
        const person = personByName(people, plName)
        if (!person) return { name, href: undefined, pl: false }
        const en = await enUrlFor("people", person.id)
        return { name, href: en ?? plPath.people(person.id), pl: !en, photo: person.data.photo?.src }
      }),
    ),
  ),
)

const related = (await localEvents("en")).filter((entry) => entry.data.battleId === source.id)
const relatedByYear = groupTimelineEntries(related, "en-GB")
const phaseInfo = BATTLE_PHASES.find((item) => item.slug === phase)
const phaseTitle = phaseInfo ? (PHASES_EN[phaseInfo.slug]?.title ?? phaseInfo.title) : undefined

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const { mentions } = await pageEntities(Astro.site!, "en", {
  body: battle.body ?? "",
  selfBattleId: source.id,
})
const jsonLd = [
  ...battleLd(Astro.site!, {
    mentions,
    lang: "en",
    path: pagePath,
    title,
    summary,
    startDate,
    endDate,
    location,
    authors,
  }),
  breadcrumbLd(Astro.site!, [
    { name: "Home", path: "/en" },
    { name: "Battles", path: "/en/battles" },
    { name: title, path: pagePath },
  ]),
]
import BattleLocator from "@/components/BattleLocator.astro"
// A one-day battle can share its title and date with the article about that
// day; the battle page then says what it is, so search results don't show two
// identical titles.
const sameAsArticle = (await localEvents("en")).some(
  (entry) => entry.data.title === title && formatDate(entry.data.date, "long", undefined, "en-GB") === range,
)
const pageTitle = `${title}${sameAsArticle ? " – the battle" : ""} (${range})`
const ogArticle = {
  section: frontEn(front),
  tags: source.data.tags.map(tagEn),
  authors: authors.map((name) => listUrl("author", "en", name)),
}
// Glossary terms used in the text (marked in the browser).
const glossaryTerms = termsIn(battle.body ?? "", "en", `bitwy/${source.id}`)
---

<BaseLayout
  jsonLd={jsonLd}
  article={ogArticle}
  title={pageTitle}
  image={articleImage(`bitwy/${source.id}`)?.asset.src}
  description={summary}
  lang="en"
  alternates={{ pl: plPath.battles(source.id) }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/en/battles" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
        ← All battles
      </a>

      {
        phaseInfo && (
          <p class="text-signal mt-6 -mb-3 font-mono text-[10px] tracking-[0.2em] uppercase">
            {phaseTitle}
          </p>
        )
      }

      <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">{title}</h1>

      {/* Wide screens: the facts move into the sidebar infobox; the authors
          stay here. */}
      <dl class="border-line text-ink-soft mt-6 hidden flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs lg:flex">
        <div>
          <dt class="inline">{authors.length > 1 ? "Authors: " : "Author: "}</dt>
          <dd class="text-ink inline">{authors.join(", ")}</dd>
        </div>
      </dl>

      <dl class="border-line text-ink-soft mt-6 grid gap-x-6 gap-y-3 border-y py-4 font-mono text-xs sm:grid-cols-[8rem_1fr] lg:hidden">
        <dt>Dates:</dt>
        <dd class="text-ink">{range}</dd>
        <dt>Front:</dt>
        <dd class="text-ink">{frontEn(front)}</dd>
        <dt>Location:</dt>
        <dd class="text-ink">
          {location}
          <BattleLocator id={source.id} frontKey={source.data.front} lang="en" />
        </dd>
        <dt>Sides:</dt>
        <dd class="text-ink space-y-2">
          {
            sides.map((side, s) => (
              <div>
                <span>{side.name}</span>
                {side.commanders.length > 0 && (
                  <span class="text-ink-soft block">
                    {commanderLinks[s].map((c, index) => (
                      <>
                        {index > 0 && ", "}
                        {c.href ? (
                          <a href={c.href} class="hover:text-signal underline decoration-dotted underline-offset-2 transition-colors">
                            {c.name}
                            {c.pl && <span class="lang-mark"> (PL)</span>}
                          </a>
                        ) : (
                          c.name
                        )}
                      </>
                    ))}
                  </span>
                )}
              </div>
            ))
          }
        </dd>
        <dt>Result:</dt>
        <dd class:list={["text-ink", milestone && "font-semibold"]}>{result}</dd>
        <dt>{authors.length > 1 ? "Authors:" : "Author:"}</dt>
        <dd class="text-ink">{authors.join(", ")}</dd>
      </dl>

      <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <ArticleFigure ref={`bitwy/${source.id}`} lang="en" />
          <div class="lg:hidden">
            <InBrief points={battle.data.brief} lang="en" />
          </div>

          <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0" data-glossary-scope>
            <CoffeeButton lang="en" class="lg:hidden" />
            <Fragment set:html={html} />
            <GlossaryMarks terms={glossaryTerms} lang="en" />
            <PersonPreviews body={battle.body ?? ""} lang="en" />
          </div>

          <BattleFamily id={source.id} part="parent" lang="en" />
          <div class="lg:hidden">
            <TopicBox ref={`bitwy/${source.id}`} lang="en" />
            <SeriesBox ref={`bitwy/${source.id}`} lang="en" />
          </div>
          <Sources sources={source.data.sources} lang="en" />
          <ReportError title={title} lang="en" />
          <div class="lg:hidden">
            <SupportCard lang="en" />
          </div>
        </div>

        <BattleSidebar
          lang="en"
          id={source.id}
          frontKey={source.data.front}
          front={frontEn(front)}
          frontHref={paths("en").front(front)}
          startDate={startDate}
          endDate={endDate}
          location={location}
          sides={sides.map((side, s) => ({ name: side.name, commanders: commanderLinks[s] }))}
          result={result}
          milestone={milestone}
          brief={battle.data.brief}
        />
      </div>

      <BattleFamily id={source.id} part="children" lang="en" />

      {
        related.length > 0 && (
          <section class="mt-16">
            <SectionHeading eyebrow="On the timeline" count={related.length} />
            <TimelineArchive
              timelineByYear={relatedByYear}
              renderAllYears={true}
              showYearNav={false}
              showBackLink={false}
              lang="en"
            />
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
