---
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { groupTimelineEntries, isPreWar } from "@/utils/groupTimelineEntries"
import { localEvents, paths } from "@/i18n/local"
import { listPageLd } from "@/utils/jsonLd"
import yearIntros from "@/data/year-intros.json"

// "The road to war": every translated article before 1914 on one page; the
// year menu shows it as "Before the war" (TimelineArchive.astro).
const allTimeline = await localEvents("en")
const timelineByYear = groupTimelineEntries(allTimeline, "en-GB")
const eraEntries = allTimeline.filter((entry) => isPreWar(entry.data.date.getUTCFullYear()))
const eraYears = timelineByYear.filter((group) => isPreWar(group.year)).map((group) => group.year)
const span = eraYears.length ? `${eraYears[0]}–${eraYears.at(-1)}` : ""
const heading = `The road to war, ${span}`
const intro = (yearIntros as Record<string, { pl: string[]; en: string[] }>)["przed-wojna"]?.en ?? []
const description = `The road to the First World War in ${eraEntries.length} articles from ${span}: the alliances, the naval race, the Moroccan crises, the Balkan Wars and the Polish preparations for the fight for independence.`
const jsonLd = listPageLd(Astro.site!, {
  lang: "en",
  path: paths("en").era,
  name: heading,
  description,
  trail: [{ name: "Timeline", path: "/en/timeline" }],
  items: eraEntries.map((entry) => entry.href),
})
---

<BaseLayout jsonLd={jsonLd} title={heading} description={description} lang="en" alternates={{ pl: paths("pl").era }}>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Timeline" count={allTimeline.length} />
    <TimelineArchive era="pre" timelineByYear={timelineByYear} heading={heading} intro={intro} lang="en" />
  </section>
</BaseLayout>
