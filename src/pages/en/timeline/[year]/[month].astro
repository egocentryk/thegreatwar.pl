---
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { localEvents } from "@/i18n/local"
import { groupTimelineEntries, isOutsideWar } from "@/utils/groupTimelineEntries"
import { periodMeta } from "@/utils/periodMeta"
import { listPageLd } from "@/utils/jsonLd"

export async function getStaticPaths() {
  const timelineByYear = groupTimelineEntries(await localEvents("en"), "en-GB")
  return timelineByYear.filter((yearGroup) => !isOutsideWar(yearGroup.year)).flatMap((yearGroup) =>
    yearGroup.months.map((monthGroup) => ({
      params: { year: String(yearGroup.year), month: monthGroup.slug },
    })),
  )
}

const allTimeline = await localEvents("en")
const timelineByYear = groupTimelineEntries(allTimeline, "en-GB")
const activeYear = Number(Astro.params.year)
const activeMonth = Astro.params.month!
const activeMonthGroup = timelineByYear
  .find((yearGroup) => yearGroup.year === activeYear)
  ?.months.find((monthGroup) => monthGroup.slug === activeMonth)
const meta = periodMeta("en", activeYear, activeMonthGroup?.entries ?? [], {
  monthLabel: activeMonthGroup?.label,
})
// Structured data: the month as a collection of its articles (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = listPageLd(Astro.site!, {
  lang: "en",
  path: pagePath,
  name: meta.heading,
  description: meta.description,
  trail: [
    { name: "Timeline", path: "/en/timeline" },
    { name: String(activeYear), path: `/en/timeline/${activeYear}` },
  ],
  items: (activeMonthGroup?.entries ?? []).map((entry) => entry.href),
})
---

<BaseLayout
  jsonLd={jsonLd}
  title={meta.title}
  description={meta.description}
  lang="en"
  alternates={{ pl: `/timeline/${activeYear}/${activeMonth}` }}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Timeline" count={allTimeline.length} />
    <TimelineArchive
      activeYear={activeYear}
      activeMonth={activeMonth}
      timelineByYear={timelineByYear}
      heading={meta.heading}
      lang="en"
    />
  </section>
</BaseLayout>
