---
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { localEvents } from "@/i18n/local"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"

export async function getStaticPaths() {
  const timelineByYear = groupTimelineEntries(await localEvents("en"), "en-GB")
  return timelineByYear.flatMap((yearGroup) =>
    yearGroup.months.map((monthGroup) => ({
      params: { year: String(yearGroup.year), month: monthGroup.slug },
    })),
  )
}

const allTimeline = await localEvents("en")
const timelineByYear = groupTimelineEntries(allTimeline, "en-GB")
const activeYear = Number(Astro.params.year)
const activeMonth = Astro.params.month!
const activeMonthLabel = timelineByYear
  .find((yearGroup) => yearGroup.year === activeYear)
  ?.months.find((monthGroup) => monthGroup.slug === activeMonth)?.label
---

<BaseLayout
  title={activeMonthLabel ? `Timeline: ${activeMonthLabel} ${activeYear}` : `Timeline ${activeYear}`}
  description={`Events of ${activeMonthLabel ?? ""} ${activeYear}, day by day.`}
  lang="en"
  alternates={{ pl: `/timeline/${activeYear}/${activeMonth}` }}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Timeline" count={allTimeline.length} />
    <TimelineArchive
      activeYear={activeYear}
      activeMonth={activeMonth}
      timelineByYear={timelineByYear}
      lang="en"
    />
  </section>
</BaseLayout>
