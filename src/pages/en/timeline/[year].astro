---
import { getCollection } from "astro:content"
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { localBattles, localEvents } from "@/i18n/local"
import { groupTimelineEntries, isPreWar } from "@/utils/groupTimelineEntries"
import { periodMeta } from "@/utils/periodMeta"
import { listPageLd } from "@/utils/jsonLd"
import yearIntros from "@/data/year-intros.json"

export async function getStaticPaths() {
  const timelineByYear = groupTimelineEntries(await localEvents("en"), "en-GB")
  return timelineByYear.filter((yearGroup) => !isPreWar(yearGroup.year)).map((yearGroup) => ({
    params: { year: String(yearGroup.year) },
  }))
}

const allTimeline = await localEvents("en")
const timelineByYear = groupTimelineEntries(allTimeline, "en-GB")
const activeYear = Number(Astro.params.year)
// "Rok w skrócie" (data/year-intros.json), written from the year's own articles.
const intro = (yearIntros as Record<string, { pl: string[]; en: string[] }>)[String(activeYear)]?.en ?? []
// The year's key battles lead the description, the ones with the most
// articles first.
const articlesPerBattle = new Map<string, number>()
for (const entry of await getCollection("timeline", ({ data }) => !data.draft)) {
  const id = entry.data.battle?.id
  if (id) articlesPerBattle.set(id, (articlesPerBattle.get(id) ?? 0) + 1)
}
const keyBattles = (await localBattles("en"))
  .filter((battle) => battle.data.milestone && battle.data.startDate.getUTCFullYear() === activeYear)
  .sort((a, b) => (articlesPerBattle.get(b.id) ?? 0) - (articlesPerBattle.get(a.id) ?? 0))
  .map((battle) => battle.data.title)
const meta = periodMeta(
  "en",
  activeYear,
  allTimeline.filter((entry) => entry.data.date.getUTCFullYear() === activeYear),
  { highlights: keyBattles },
)
// Structured data: the year as a collection of its articles (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = listPageLd(Astro.site!, {
  lang: "en",
  path: pagePath,
  name: meta.heading,
  description: meta.description,
  trail: [{ name: "Timeline", path: "/en/timeline" }],
  items: (timelineByYear.find((group) => group.year === activeYear)?.months ?? []).flatMap((month) =>
    month.entries.map((entry) => entry.href),
  ),
})
---

<BaseLayout
  jsonLd={jsonLd}
  title={meta.title}
  description={meta.description}
  lang="en"
  alternates={{ pl: `/timeline/${activeYear}` }}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Timeline" count={allTimeline.length} />
    <TimelineArchive activeYear={activeYear} timelineByYear={timelineByYear} heading={meta.heading} intro={intro} lang="en" />
  </section>
</BaseLayout>
