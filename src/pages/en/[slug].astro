---
// English event page: /en/<english-slug>. Text from src/content/en/timeline,
// everything else from the Polish entry named in `source`.
import { getEntry, render } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "@/layouts/BaseLayout.astro"
import CoffeeButton from "@/components/CoffeeButton.astro"
import { formatDate } from "@/utils/formatDate"
import {
  categoryEn,
  enUrlFor,
  frontEn,
  plPath,
  rewriteEnHtml,
  translatedTimeline,
} from "@/i18n"
import { articleLd, breadcrumbLd } from "@/utils/jsonLd"

type AssetImage = {
  src: string
  width: number
  height: number
  format: "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "svg" | "avif" | "apng"
}
const articleImages = import.meta.glob<{ default: AssetImage }>("../../assets/images/*", {
  eager: true,
})

export async function getStaticPaths() {
  const items = await translatedTimeline()
  return items.map((item, index) => ({
    params: { slug: item.entry.id },
    props: { item, previous: items[index - 1], next: items[index + 1] },
  }))
}

const { item, previous, next } = Astro.props
const { entry, source } = item
const { title, summary } = entry.data
const { category, front, date, authors, headerImage, milestone, battle, tags } = source.data
await render(entry)
const html = await rewriteEnHtml(entry.rendered?.html ?? "")
const battlePl = battle ? await getEntry(battle) : undefined
const battleEnUrl = battlePl ? await enUrlFor("battles", battlePl.id) : undefined
const battleEn = battleEnUrl
  ? await getEntry("battlesEn", battleEnUrl.split("/").pop()!)
  : undefined

const fmt = (d: Date) => formatDate(d, "long", undefined, "en-GB")
const formattedDate = fmt(date)
const headerImageAsset = headerImage
  ? articleImages[`../../assets/images/${headerImage}`]?.default
  : undefined

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = [
  articleLd(Astro.site!, {
    lang: "en",
    path: pagePath,
    title,
    summary,
    date,
    authors,
    image: headerImageAsset?.src,
  }),
  breadcrumbLd(Astro.site!, [
    { name: "Home", path: "/en" },
    { name: "Timeline", path: "/en/timeline" },
    { name: String(date.getUTCFullYear()), path: `/en/timeline/${date.getUTCFullYear()}` },
    { name: title, path: pagePath },
  ]),
]
import { tagEn } from "@/i18n/data-en"
import { listUrl } from "@/utils/filteredPages"
import RelatedEvents from "@/components/RelatedEvents.astro"
---

<BaseLayout
  jsonLd={jsonLd}
  title={`${title} (${formattedDate})`}
  description={summary}
  image={headerImageAsset?.src}
  lang="en"
  alternates={{ pl: plPath.timeline(source.id) }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-3xl px-6">
      <a href="/en/timeline" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
        ← Timeline
      </a>

      {
        milestone && (
          <p class="text-signal mt-6 -mb-3 flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] uppercase">
            <span aria-hidden="true" class="bg-signal ring-signal/25 ml-1 size-2 rounded-full ring-4" />
            Key event
          </p>
        )
      }

      <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">{title}</h1>
    </div>

    {
      headerImageAsset && (
        <div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-sm">
          <Image src={headerImageAsset} alt={title} class="h-auto w-full object-cover" sizes="(min-width: 1024px) 1024px, 100vw" />
        </div>
      )
    }

    <div class="mx-auto max-w-3xl px-6">
      <dl class="border-line text-ink-soft mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs">
        <div>
          <dt class="inline">Category: </dt>
          <dd class="inline">
            <a href={listUrl("category", "en", category)} class="text-ink hover:text-signal transition-colors">
              {categoryEn(category)}
            </a>
          </dd>
        </div>
        {front && <div><dt class="inline">Front: </dt><dd class="text-ink inline">{frontEn(front)}</dd></div>}
        <div><dt class="inline">Date: </dt><dd class="text-ink inline">{formattedDate}</dd></div>
        <div>
          <dt class="inline">{authors.length > 1 ? "Authors: " : "Author: "}</dt>
          <dd class="inline">
            {authors.map((name, index) => (
              <>
                {index > 0 && ", "}
                <a href={listUrl("author", "en", name)} class="text-ink hover:text-signal transition-colors">{name}</a>
              </>
            ))}
          </dd>
        </div>
        {
          battlePl && (
            <div>
              <dt class="inline">Battle: </dt>
              <dd class="inline">
                {battleEnUrl && battleEn ? (
                  <a href={battleEnUrl} class="text-ink hover:text-signal transition-colors">{battleEn.data.title}</a>
                ) : (
                  <a href={plPath.battles(battlePl.id)} class="text-ink hover:text-signal transition-colors">
                    {battlePl.data.title} <span class="lang-mark">(PL)</span>
                  </a>
                )}
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt class="inline">Tags: </dt>
              <dd class="inline">
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={listUrl("tag", "en", tag)} class="text-ink hover:text-signal transition-colors">{tagEn(tag)}</a>
                  </>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0">
        <CoffeeButton lang="en" />
        <Fragment set:html={html} />
      </div>

      <RelatedEvents id={source.id} lang="en" />

      {
        (previous || next) && (
          <nav aria-label="Adjacent events" class="border-line mt-12 grid gap-4 border-t pt-6 sm:grid-cols-2">
            {previous ? (
              <a href={`/en/${previous.entry.id}`} rel="prev" class="group border-line hover:border-signal block rounded-sm border p-4 transition-colors">
                <span class="text-ink-soft block font-mono text-[11px]">
                  ← Previous event · {fmt(previous.source.data.date)}
                </span>
                <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg transition-colors">
                  {previous.entry.data.title}
                </span>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )}
            {next && (
              <a href={`/en/${next.entry.id}`} rel="next" class="group border-line hover:border-signal block rounded-sm border p-4 text-right transition-colors">
                <span class="text-ink-soft block font-mono text-[11px]">
                  {fmt(next.source.data.date)} · Next event →
                </span>
                <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg transition-colors">
                  {next.entry.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</BaseLayout>
