---
import TopicPage from "@/components/TopicPage.astro"
import { localTopics, type LocalTopic } from "@/utils/topics"

export async function getStaticPaths() {
  return (await localTopics("en")).map((topic) => ({ params: { slug: topic.slug }, props: { topic } }))
}

interface Props {
  topic: LocalTopic
}

const { topic } = Astro.props
---

<TopicPage topic={topic} lang="en" />
