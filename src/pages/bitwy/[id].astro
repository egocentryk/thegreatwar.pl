---
import { getCollection, render, type CollectionEntry } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { enUrlFor } from "@/i18n"
import BattleSidebar from "@/components/BattleSidebar.astro"
import CoffeeButton from "@/components/CoffeeButton.astro"
import GlossaryMarks from "@/components/GlossaryMarks.astro"
import PersonPreviews from "@/components/PersonPreviews.astro"
import { termsIn } from "@/utils/glossary"
import ArticleFigure from "@/components/ArticleFigure.astro"
import InBrief from "@/components/InBrief.astro"
import { articleImage } from "@/utils/articleImages"
import ReportError from "@/components/ReportError.astro"
import BattleFamily from "@/components/BattleFamily.astro"
import SeriesBox from "@/components/SeriesBox.astro"
import Sources from "@/components/Sources.astro"
import SupportCard from "@/components/SupportCard.astro"
import { paths } from "@/i18n/local"
import SectionHeading from "@/components/SectionHeading.astro"
import TimelineArchive from "@/components/TimelineArchive.astro"
import { BATTLE_PHASES } from "@/data/battlePhases"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"
import { getPeople, personByName } from "@/utils/people"
import { battleLd, breadcrumbLd } from "@/utils/jsonLd"
import { slugify } from "@/utils/slugify"
import { listUrl } from "@/utils/filteredPages"
import { pageEntities } from "@/utils/pageEntities"

export async function getStaticPaths() {
  const battles = await getCollection("battles", ({ data }) => !data.draft)
  return battles.map((battle) => ({
    params: { id: battle.id },
    props: { battle },
  }))
}

interface Props {
  battle: CollectionEntry<"battles">
}

const { battle } = Astro.props
const enUrl = await enUrlFor("battles", battle.id)
const {
  title,
  summary,
  front,
  phase,
  startDate,
  endDate,
  location,
  sides,
  result,
  authors,
  tags,
  milestone,
} = battle.data
const { Content } = await render(battle)

const phaseInfo = BATTLE_PHASES.find((item) => item.slug === phase)
const relatedEntries = await getCollection(
  "timeline",
  ({ data }) => !data.draft && data.battle?.id === battle.id,
)
const relatedByYear = groupTimelineEntries(relatedEntries)
// Commanders with a person page become links.
const people = await getPeople()
// The same, with portraits, for the sidebar infobox.
const infoSides = sides.map((side) => ({
  name: side.name,
  commanders: side.commanders.map((name) => {
    const person = personByName(people, name)
    return { name, href: person && `/postacie/${person.id}`, photo: person?.data.photo?.src }
  }),
}))

// Structured data for search engines (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const { mentions } = await pageEntities(Astro.site!, "pl", {
  body: battle.body ?? "",
  selfBattleId: battle.id,
})
const jsonLd = [
  ...battleLd(Astro.site!, {
    mentions,
    lang: "pl",
    path: pagePath,
    title,
    summary,
    startDate,
    endDate,
    location,
    authors,
  }),
  breadcrumbLd(Astro.site!, [
    { name: "Strona główna", path: "/" },
    { name: "Bitwy", path: "/bitwy" },
    { name: title, path: pagePath },
  ]),
]
import BattleLocator from "@/components/BattleLocator.astro"
// A one-day battle can share its title and date with the article about that
// day ("Atak na Pearl Harbor (7 grudnia 1941)"); the battle page then says
// what it is, so search results don't show two identical titles.
const range = formatDateRange(startDate, endDate)
const sameAsArticle = (await getCollection("timeline", ({ data }) => !data.draft)).some(
  (entry) => entry.data.title === title && formatDate(entry.data.date) === range,
)
const pageTitle = `${title}${sameAsArticle ? " – przebieg bitwy" : ""} (${range})`
const ogArticle = {
  section: front,
  tags,
  authors: authors.map((name) => listUrl("author", "pl", name)),
}
// Glossary terms used in the text (marked in the browser).
const glossaryTerms = termsIn(battle.body ?? "", "pl", `bitwy/${battle.id}`)
---

<BaseLayout
  jsonLd={jsonLd}
  article={ogArticle}
  title={pageTitle}
  image={articleImage(`bitwy/${battle.id}`)?.asset.src}
  description={summary}
  alternates={{ en: enUrl }}
>
  <article class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-6xl px-6">
      <a
        href="/bitwy"
        class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
      >
        ← Wszystkie bitwy
      </a>

      {
        phaseInfo && (
          <p class="text-signal mt-6 -mb-3 font-mono text-[10px] tracking-[0.2em] uppercase">
            {phaseInfo.title}
          </p>
        )
      }

      <h1
        class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl"
      >
        {title}
      </h1>

      {/* Wide screens: the facts move into the sidebar infobox; authors
          and tags stay here in one line. */}
      <dl class="border-line text-ink-soft mt-6 hidden flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs lg:flex">
        <div>
          <dt class="inline">{authors.length > 1 ? "Autorzy: " : "Autor: "}</dt>
          <dd class="inline">
            {authors.map((name, index) => (
              <>
                {index > 0 && ", "}
                <a href={`/autor/${slugify(name)}`} class="text-ink hover:text-signal transition-colors">{name}</a>
              </>
            ))}
          </dd>
        </div>
        {tags.length > 0 && (
          <div>
            <dt class="inline">Tagi: </dt>
            <dd class="inline">
              {tags.map((tag, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`/tag/${slugify(tag)}`} class="text-ink hover:text-signal transition-colors">{tag}</a>
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>

      <dl
        class="border-line text-ink-soft mt-6 grid gap-x-6 gap-y-3 border-y py-4 font-mono text-xs sm:grid-cols-[8rem_1fr] lg:hidden"
      >
        <dt>Daty:</dt>
        <dd class="text-ink">{formatDateRange(startDate, endDate)}</dd>
        <dt>Front:</dt>
        <dd class="text-ink">{front}</dd>
        <dt>Miejsce:</dt>
        <dd class="text-ink">
          {location}
          <BattleLocator id={battle.id} frontKey={front} />
        </dd>
        <dt>Strony:</dt>
        <dd class="text-ink space-y-2">
          {
            sides.map((side) => (
              <div>
                <span>{side.name}</span>
                {side.commanders.length > 0 && (
                  <span class="text-ink-soft block">
                    {side.commanders.map((commander, index) => {
                      const person = personByName(people, commander)
                      return (
                        <>
                          {index > 0 && ", "}
                          {person ? (
                            <a
                              href={`/postacie/${person.id}`}
                              class="hover:text-signal underline decoration-dotted underline-offset-2 transition-colors"
                            >
                              {commander}
                            </a>
                          ) : (
                            commander
                          )}
                        </>
                      )
                    })}
                  </span>
                )}
              </div>
            ))
          }
        </dd>
        <dt>Wynik:</dt>
        <dd class:list={["text-ink", milestone && "font-semibold"]}>{result}</dd>
        <dt>{authors.length > 1 ? "Autorzy:" : "Autor:"}</dt>
        <dd>
          {
            authors.map((name, index) => (
              <>
                {index > 0 && ", "}
                <a
                  href={`/autor/${slugify(name)}`}
                  class="text-ink hover:text-signal transition-colors"
                >
                  {name}
                </a>
              </>
            ))
          }
        </dd>
        {
          tags.length > 0 && (
            <>
              <dt>Tagi:</dt>
              <dd>
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ", "}
                    <a
                      href={`/tag/${slugify(tag)}`}
                      class="text-ink hover:text-signal transition-colors"
                    >
                      {tag}
                    </a>
                  </>
                ))}
              </dd>
            </>
          )
        }
      </dl>

      <div class="lg:grid lg:grid-cols-[minmax(0,42rem)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <ArticleFigure ref={`bitwy/${battle.id}`} />
          <div class="lg:hidden">
            <InBrief points={battle.data.brief} />
          </div>

          <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl [&>*:nth-child(2)]:mt-0" data-glossary-scope>
            <CoffeeButton class="lg:hidden" />
            <Content />
            <GlossaryMarks terms={glossaryTerms} lang="pl" />
            <PersonPreviews body={battle.body ?? ""} lang="pl" />
          </div>

          <BattleFamily id={battle.id} part="parent" />
          <div class="lg:hidden">
            <SeriesBox ref={`bitwy/${battle.id}`} />
          </div>
          <Sources sources={battle.data.sources} />
          <ReportError title={title} />
          <div class="lg:hidden">
            <SupportCard />
          </div>
        </div>

        <BattleSidebar
          id={battle.id}
          frontKey={front}
          front={front}
          frontHref={paths("pl").front(front)}
          startDate={startDate}
          endDate={endDate}
          location={location}
          sides={infoSides}
          result={result}
          milestone={milestone}
          brief={battle.data.brief}
        />
      </div>

      <BattleFamily id={battle.id} part="children" />

      {
        relatedEntries.length > 0 && (
          <section class="mt-16">
            <SectionHeading
              eyebrow="Na osi czasu"
              count={relatedEntries.length}
            />
            <TimelineArchive
              timelineByYear={relatedByYear}
              renderAllYears={true}
              showYearNav={false}
              showBackLink={false}
            />
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
