---
import { SITE } from "@/site.config"

const year = new Date().getFullYear()
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      {`© ${year} ${SITE.name}.`} Built with{" "}
      <svg
        class="inline-block size-3.5 -translate-y-px align-middle text-red-600"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        role="img"
        aria-label="love"
      >
        <path
          d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
        ></path>
      </svg>
    </p>

    <nav class="flex items-center gap-4" aria-label="Social">
      {
        SITE.social.map((link) => (
          <a
            href={link.href}
            class="hover:text-signal transition-colors"
            rel="me"
          >
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
