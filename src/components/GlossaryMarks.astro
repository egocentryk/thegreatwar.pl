---
// Marks the first mention of each glossary term (utils/glossary.ts) in the
// text inside the nearest [data-glossary-scope], and shows its short
// definition in a card on hover, focus or tap. The page passes only the
// terms its text uses; without JavaScript nothing is marked.
import type { Lang } from "@/i18n"
import type { MarkedTerm } from "@/utils/glossary"

interface Props {
  terms: MarkedTerm[]
  lang?: Lang
}

const { terms, lang = "pl" } = Astro.props
const more = lang === "en" ? "Glossary →" : "Słownik →"
---

{
  terms.length > 0 && (
    <script type="application/json" data-glossary-terms data-more={more} set:html={JSON.stringify(terms)} />
  )
}

<script>
  interface Term {
    slug: string
    term: string
    short: string
    href: string
    pattern: string
  }

  const SKIP = "a, h1, h2, h3, h4, h5, h6, figcaption, code, .not-prose, .gloss"

  // First match of each term, in document order; longer terms first so that
  // "Waffen-SS" wins over "SS".
  function mark(scope: HTMLElement, terms: Term[]) {
    const sorted = [...terms].sort((a, b) => b.term.length - a.term.length)
    for (const term of sorted) {
      const re = new RegExp(term.pattern, "u")
      const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT, {
        acceptNode: (node) =>
          node.parentElement?.closest(SKIP) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT,
      })
      for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
        const m = re.exec(node.data)
        if (!m) continue
        const hit = node.splitText(m.index)
        hit.splitText(m[0].length)
        const link = document.createElement("a")
        link.href = term.href
        link.className = "gloss"
        link.dataset.gloss = term.slug
        link.textContent = hit.data
        hit.replaceWith(link)
        break
      }
    }
  }

  let card: HTMLElement | undefined
  let hideTimer: number | undefined

  function show(link: HTMLAnchorElement, term: Term, more: string) {
    window.clearTimeout(hideTimer)
    card ??= Object.assign(document.createElement("div"), { className: "gloss-card", role: "tooltip" })
    if (!card.isConnected) {
      document.body.append(card)
      card.addEventListener("mouseenter", () => window.clearTimeout(hideTimer))
      card.addEventListener("mouseleave", hide)
    }
    card.replaceChildren()
    const title = Object.assign(document.createElement("p"), { className: "gloss-card-term", textContent: term.term })
    const text = Object.assign(document.createElement("p"), { className: "gloss-card-text", textContent: term.short })
    const link2 = Object.assign(document.createElement("a"), { className: "gloss-card-more", href: term.href, textContent: more })
    card.append(title, text, link2)
    card.hidden = false
    const r = link.getBoundingClientRect()
    const width = Math.min(320, window.innerWidth - 32)
    card.style.width = `${width}px`
    const left = Math.max(16, Math.min(r.left + window.scrollX, window.scrollX + window.innerWidth - width - 16))
    card.style.left = `${left}px`
    card.style.top = `${r.bottom + window.scrollY + 8}px`
  }

  function hide() {
    hideTimer = window.setTimeout(() => {
      if (card) card.hidden = true
    }, 150)
  }

  function init() {
    const data = document.querySelector<HTMLScriptElement>("[data-glossary-terms]")
    const scope = document.querySelector<HTMLElement>("[data-glossary-scope]")
    if (!data || !scope) return
    const terms: Term[] = JSON.parse(data.textContent ?? "[]")
    const more = data.dataset.more ?? "→"
    const bySlug = new Map(terms.map((t) => [t.slug, t]))
    mark(scope, terms)
    const touch = window.matchMedia("(hover: none)").matches
    scope.querySelectorAll<HTMLAnchorElement>("a.gloss").forEach((link) => {
      const term = bySlug.get(link.dataset.gloss ?? "")
      if (!term) return
      link.addEventListener("mouseenter", () => show(link, term, more))
      link.addEventListener("mouseleave", hide)
      link.addEventListener("focus", () => show(link, term, more))
      link.addEventListener("blur", hide)
      // On touch screens the first tap opens the card, the link inside it leads on.
      if (touch)
        link.addEventListener("click", (event) => {
          if (card?.hidden === false && card.dataset.for === term.slug) return
          event.preventDefault()
          show(link, term, more)
          card!.dataset.for = term.slug
        })
    })
    document.addEventListener("click", (event) => {
      const target = event.target as Element
      if (card && !card.hidden && !card.contains(target) && !target.closest("a.gloss")) card.hidden = true
    })
  }

  document.addEventListener("astro:page-load", init)
</script>

<style is:global>
  .gloss {
    color: inherit;
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in oklab, var(--ink-soft) 70%, transparent);
    text-underline-offset: 3px;
    cursor: help;
  }
  .prose .gloss {
    color: inherit;
    font-weight: inherit;
  }
  .gloss:hover {
    text-decoration-color: var(--signal);
  }
  .gloss-card {
    position: absolute;
    z-index: 50;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    padding: 0.875rem 1rem;
    box-shadow: 0 10px 30px -12px color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .gloss-card-term {
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 1rem;
  }
  .gloss-card-text {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.35rem;
  }
  .gloss-card-more {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
</style>
