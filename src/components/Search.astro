---
import SectionHeading from "@/components/SectionHeading.astro"

interface Props {
  // Full results page: all hits and the query kept in the URL.
  full?: boolean
}

const { full = false } = Astro.props
const LIMIT = full ? 200 : 6
---

<section
  id="szukaj"
  class:list={["mx-auto max-w-3xl px-6", full ? "pt-16 pb-24 sm:pt-24" : "pb-20"]}
  data-search
  data-limit={LIMIT}
  data-full={full ? "" : undefined}
>
  <SectionHeading eyebrow="Szukaj" />

  {
    !full && (
      <p class="font-display text-ink text-2xl leading-snug sm:text-3xl">
        Znajdź wydarzenie, bitwę lub postać.
      </p>
    )
  }

  <form
    action="/szukaj"
    method="get"
    role="search"
    class:list={[full ? "" : "mt-6"]}
    data-form
  >
    <label for={full ? "q-full" : "q-home"} class="sr-only">
      Szukaj w kronice
    </label>
    <div
      class="group border-line bg-surface focus-within:border-signal flex items-center gap-3 rounded-sm border px-4 transition-colors"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="text-ink-soft group-focus-within:text-signal size-5 shrink-0 transition-colors"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
        ></path></svg
      >
      <input
        id={full ? "q-full" : "q-home"}
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="np. Verdun, Piłsudski, Lusitania, Lwów 1918…"
        class="text-ink placeholder:text-ink-soft/70 w-full bg-transparent py-4 text-base outline-none [&::-webkit-search-cancel-button]:hidden"
        data-input
      />
      <kbd
        class="border-line text-ink-soft hidden shrink-0 rounded-sm border px-1.5 py-0.5 font-mono text-[10px] sm:inline-block"
        data-hint>/</kbd
      >
    </div>
  </form>

  <div class="mt-4 flex flex-wrap items-center gap-2" data-suggestions>
    <span class="text-ink-soft font-mono text-[10px] tracking-[0.15em] uppercase"
      >Na przykład:</span
    >
    {
      ["Verdun", "Piłsudski", "Lusitania", "Gallipoli", "rewolucja", "Lwów"].map(
        (term) => (
          <button
            type="button"
            data-term={term}
            class="border-line text-ink-soft hover:border-signal hover:text-signal cursor-pointer rounded-full border px-3 py-1 text-xs transition-colors"
          >
            {term}
          </button>
        ),
      )
    }
  </div>

  <p class="text-ink-soft mt-6 font-mono text-xs" data-status aria-live="polite">
  </p>

  <ol class="mt-3" data-results></ol>

  <a
    href="/szukaj"
    class="text-signal mt-6 hidden font-mono text-xs hover:underline"
    data-more></a
  >

  <template data-result-template>
    <li class="border-line border-b last:border-b-0">
      <a class="group grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-4" data-href>
        <span class="text-ink-soft font-mono text-xs leading-6">
          <span data-date></span>
        </span>
        <span class="min-w-0">
          <span
            class="text-ink-soft flex items-center gap-2 font-mono text-[10px] tracking-[0.15em] uppercase"
          >
            <span
              data-milestone
              title="Kluczowe wydarzenie"
              class="bg-signal ring-signal/25 size-1.5 shrink-0 rounded-full ring-4"
            ></span>
            <span data-kind></span>
          </span>
          <span
            class="font-display text-ink group-hover:text-signal mt-1 block text-lg leading-snug transition-colors [&_mark]:bg-signal/20 [&_mark]:text-inherit [&_mark]:rounded-[2px]"
            data-title></span>
          <span
            class="text-ink-soft mt-1 line-clamp-2 block text-sm leading-6 [&_mark]:bg-signal/15 [&_mark]:text-inherit [&_mark]:rounded-[2px]"
            data-summary></span>
        </span>
      </a>
    </li>
  </template>
</section>

<script>
  import type { SearchDoc } from "@/pages/szukaj.json"

  // Lowercase and strip Polish diacritics one character at a time, so the
  // normalized text keeps the original's length and match positions map back
  // for highlighting.
  const fold = (text: string) =>
    [...text]
      .map((char) => {
        const lower = char.toLowerCase()
        if (lower === "ł") return "l"
        return lower.normalize("NFD")[0] ?? lower
      })
      .join("")

  // Crude Polish stemming: "Warszawa" also finds "Warszawę", "Piłsudski"
  // finds "Piłsudskiego". Words drop their ending: one letter from five
  // letters up, two from eight.
  const stem = (token: string) =>
    token.length >= 8
      ? token.slice(0, -2)
      : token.length >= 5
        ? token.slice(0, -1)
        : token

  interface Indexed {
    doc: SearchDoc
    title: string
    summary: string
    tags: string
  }

  let index: Promise<Indexed[]> | undefined
  function loadIndex() {
    index ??= fetch("/szukaj.json")
      .then((response) => (response.ok ? response.json() : []))
      .then((docs: SearchDoc[]) =>
        docs.map((doc) => ({
          doc,
          title: fold(doc.t),
          summary: fold(doc.s),
          tags: fold(`${doc.g} ${doc.k.slice(0, 4)}`),
        })),
      )
      .catch(() => [])
    return index
  }

  function search(items: Indexed[], query: string) {
    const tokens = fold(query)
      .split(/[^\p{L}\p{N}]+/u)
      .filter(Boolean)
      .map(stem)
    if (!tokens.length) return { tokens, hits: [] as Indexed[] }

    const scored: { item: Indexed; score: number }[] = []
    for (const item of items) {
      let score = 0
      let all = true
      for (const token of tokens) {
        const inTitle = item.title.includes(token)
        const inTags = item.tags.includes(token)
        const inSummary = item.summary.includes(token)
        if (!inTitle && !inTags && !inSummary) {
          all = false
          break
        }
        score += (inTitle ? 6 : 0) + (inTags ? 3 : 0) + (inSummary ? 1 : 0)
        if (item.title.startsWith(token)) score += 2
      }
      if (!all) continue
      if (item.doc.m) score += 2
      if (item.doc.y === "b") score += 1
      scored.push({ item, score })
    }
    scored.sort(
      (a, b) => b.score - a.score || a.item.doc.k.localeCompare(b.item.doc.k),
    )
    return { tokens, hits: scored.map((s) => s.item) }
  }

  // Wrap every token occurrence in <mark>, building text nodes (no innerHTML).
  function highlight(target: Element, text: string, folded: string, tokens: string[]) {
    const marks = new Array(text.length).fill(false)
    for (const token of tokens) {
      let at = folded.indexOf(token)
      while (at !== -1) {
        // Mark through the end of the word, so "Warszaw|ą" lights up whole.
        let end = at + token.length
        while (end < folded.length && /[\p{L}\p{N}]/u.test(folded[end])) end++
        marks.fill(true, at, end)
        at = folded.indexOf(token, end)
      }
    }
    target.replaceChildren()
    let start = 0
    for (let i = 1; i <= text.length; i++) {
      if (i === text.length || marks[i] !== marks[start]) {
        const chunk = text.slice(start, i)
        if (marks[start]) {
          const mark = document.createElement("mark")
          mark.textContent = chunk
          target.append(mark)
        } else {
          target.append(chunk)
        }
        start = i
      }
    }
  }

  const plural = (n: number) => {
    if (n === 1) return "wynik"
    const last = n % 10
    const lastTwo = n % 100
    return last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14)
      ? "wyniki"
      : "wyników"
  }

  function initSearch() {
    const section = document.querySelector<HTMLElement>("[data-search]")
    if (!section || section.dataset.ready) return
    section.dataset.ready = "1"

    const input = section.querySelector<HTMLInputElement>("[data-input]")!
    const form = section.querySelector<HTMLFormElement>("[data-form]")!
    const list = section.querySelector("[data-results]")!
    const status = section.querySelector("[data-status]")!
    const more = section.querySelector<HTMLAnchorElement>("[data-more]")!
    const template = section.querySelector<HTMLTemplateElement>(
      "[data-result-template]",
    )!
    const limit = Number(section.dataset.limit) || 6
    const full = section.hasAttribute("data-full")

    let timer: number | undefined

    async function run() {
      const query = input.value.trim()
      if (full) {
        const url = new URL(location.href)
        if (query) url.searchParams.set("q", query)
        else url.searchParams.delete("q")
        history.replaceState(null, "", url)
      }
      if (query.length < 2) {
        list.replaceChildren()
        status.textContent = ""
        more.classList.add("hidden")
        return
      }

      status.textContent = "Szukam…"
      const items = await loadIndex()
      if (input.value.trim() !== query) return
      const { tokens, hits } = search(items, query)

      list.replaceChildren()
      for (const item of hits.slice(0, limit)) {
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement
        row.querySelector("[data-href]")!.setAttribute("href", item.doc.h)
        row.querySelector("[data-date]")!.textContent = item.doc.d
        row.querySelector("[data-kind]")!.textContent =
          item.doc.y === "b" ? "Bitwa" : "Wydarzenie"
        row
          .querySelector("[data-milestone]")!
          .classList.toggle("hidden", !item.doc.m)
        highlight(row.querySelector("[data-title]")!, item.doc.t, item.title, tokens)
        highlight(
          row.querySelector("[data-summary]")!,
          item.doc.s,
          item.summary,
          tokens,
        )
        list.append(row)
      }

      status.textContent = hits.length
        ? `${hits.length} ${plural(hits.length)} dla „${query}”`
        : `Nic nie znaleźliśmy dla „${query}”. Spróbuj innej formy słowa albo krótszego zapytania.`

      const hidden = hits.length > limit
      more.classList.toggle("hidden", !hidden)
      more.classList.toggle("inline-block", hidden)
      if (hidden) {
        more.href = `/szukaj?q=${encodeURIComponent(query)}`
        more.textContent = full
          ? `Pokazujemy ${limit} pierwszych — zawęź zapytanie, by zobaczyć resztę.`
          : `Wszystkie wyniki (${hits.length}) →`
        if (full) more.removeAttribute("href")
      }
    }

    input.addEventListener("focus", () => loadIndex(), { once: true })
    input.addEventListener("input", () => {
      window.clearTimeout(timer)
      timer = window.setTimeout(run, 120)
    })
    form.addEventListener("submit", (event) => {
      if (full) {
        event.preventDefault()
        run()
      }
    })
    for (const button of section.querySelectorAll<HTMLButtonElement>("[data-term]")) {
      button.addEventListener("click", () => {
        input.value = button.dataset.term ?? ""
        input.focus()
        run()
      })
    }

    const initial = new URLSearchParams(location.search).get("q")
    if (initial) {
      input.value = initial
      run()
    }
    if (full) input.focus()
  }

  // "/" focuses the search box from anywhere on a page that has one.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return
    const target = event.target as HTMLElement
    if (target.closest("input, textarea, select, [contenteditable]")) return
    const input = document.querySelector<HTMLInputElement>("[data-search] [data-input]")
    if (!input) return
    event.preventDefault()
    input.focus()
  })

  document.addEventListener("astro:page-load", initSearch)
</script>
