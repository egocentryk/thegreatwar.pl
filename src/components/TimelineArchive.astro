---
import PrintButton from "@/components/PrintButton.astro"
import type { Lang } from "@/i18n"
import { paths } from "@/i18n/local"
import TimelineMonth from "@/components/TimelineMonth.astro"
import { isPreWar, type ArchiveEntry, type TimelineYearGroup } from "@/utils/groupTimelineEntries"

interface Props {
  activeYear?: number
  activeMonth?: string
  timelineByYear: TimelineYearGroup<ArchiveEntry>[]
  showYearNav?: boolean
  showBackLink?: boolean
  renderAllYears?: boolean
  // Year and month pages: the year heading becomes the page's <h1> with this
  // text ("1916", "Marzec 1916").
  heading?: string
  // Year pages: "Rok w skrócie", paragraphs shown under the heading.
  intro?: string[]
  // The era page: every year before the war under one heading, each year
  // with its months (utils/groupTimelineEntries.ts, WAR_START_YEAR).
  era?: boolean
  lang?: Lang
}

const {
  activeYear,
  activeMonth,
  timelineByYear,
  showYearNav = true,
  showBackLink = true,
  renderAllYears = false,
  heading,
  intro = [],
  era = false,
  lang = "pl",
} = Astro.props
const YearHeading = heading ? "h1" : "h2"
const to = paths(lang)
const t = {
  pl: {
    years: "Lata",
    months: "Miesiące",
    backToYear: "wróć do roku",
    era: "Przed wojną",
    yearIntro: "Rok w skrócie",
    eraIntro: "W skrócie",
  },
  en: {
    years: "Years",
    months: "Months",
    backToYear: "back to",
    era: "Before the war",
    yearIntro: "The year in brief",
    eraIntro: "In brief",
  },
}[lang]
// The years before the war appear in the menu as one item, the era page.
const hasEra = timelineByYear.some((yearGroup) => isPreWar(yearGroup.year))
const years = timelineByYear.map((yearGroup) => yearGroup.year).filter((year) => !isPreWar(year))
const activeGroup = era
  ? undefined
  : (timelineByYear.find((yearGroup) => yearGroup.year === activeYear) ??
    timelineByYear.find((yearGroup) => !isPreWar(yearGroup.year)) ??
    timelineByYear[0])
const visibleYearGroups = era
  ? timelineByYear.filter((yearGroup) => isPreWar(yearGroup.year))
  : renderAllYears
    ? timelineByYear
    : activeGroup
      ? [activeGroup]
      : []
---

{
  visibleYearGroups.length > 0 && (
    <>
      {showYearNav && (
        <div class="border-line mt-10 space-y-4 border-b pb-4 font-mono print:hidden">
          <nav
            class="font-display flex flex-wrap gap-x-6 gap-y-2 text-2xl leading-none font-medium sm:gap-x-8 sm:text-3xl"
            aria-label={t.years}
          >
            {hasEra && (
              <a
                href={to.era}
                aria-current={era ? "page" : undefined}
                class:list={["transition-colors", era ? "text-signal" : "text-ink-soft hover:text-ink"]}
              >
                {t.era}
              </a>
            )}
            {years.map((year) => (
              <a
                href={to.year(year)}
                aria-current={
                  year === activeYear && !activeMonth ? "page" : undefined
                }
                class:list={[
                  "transition-colors",
                  year === activeYear
                    ? "text-signal"
                    : "text-ink-soft hover:text-ink",
                ]}
              >
                {year}
              </a>
            ))}
          </nav>

          {activeGroup && (
            <nav
              class="flex flex-wrap items-center gap-x-2 gap-y-2 text-[9px] tracking-[0.2em] uppercase"
              aria-label={`${t.months} ${activeGroup.year}`}
            >
              {activeGroup.months.map((monthGroup, index) => (
                <>
                  {index > 0 && (
                    <span aria-hidden="true" class="text-ink-soft">
                      ·
                    </span>
                  )}
                  <a
                    href={to.month(activeGroup.year, monthGroup.slug)}
                    aria-current={
                      monthGroup.slug === activeMonth ? "page" : undefined
                    }
                    class:list={[
                      "transition-colors",
                      monthGroup.slug === activeMonth
                        ? "text-signal"
                        : "text-ink-soft hover:text-ink",
                    ]}
                  >
                    {monthGroup.label}
                  </a>
                </>
              ))}
            </nav>
          )}
        </div>
      )}

      {era && (
        <section class="mt-10">
          {/* The era: its heading and intro once, then each year with its
              months, as in the year pages' two-column layout. */}
          <div class="lg:grid lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12">
            <div class="lg:sticky lg:top-24 lg:self-start print:static">
              <div class="flex items-baseline justify-between gap-4">
                <h1 class="font-display text-ink text-3xl font-medium sm:text-4xl">{heading ?? t.era}</h1>
                <PrintButton lang={lang} />
              </div>
              {intro.length > 0 && (
                <div class="border-signal mt-6 max-w-2xl space-y-4 border-l-2 pl-5 lg:max-h-[calc(100vh-13rem)] lg:overflow-y-auto print:max-h-none">
                  <p class="text-signal font-mono text-[10px] tracking-[0.2em] uppercase">{t.eraIntro}</p>
                  {intro.map((paragraph) => (
                    <p class="text-ink leading-7 lg:text-[15px] lg:leading-6">{paragraph}</p>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-6 min-w-0 space-y-12 lg:mt-0">
              {visibleYearGroups.map((yearGroup) => (
                <section>
                  <h2 class="font-display text-ink text-2xl font-medium sm:text-3xl">{yearGroup.year}</h2>
                  <div class="mt-4 space-y-8">
                    {yearGroup.months.map((monthGroup) => (
                      <TimelineMonth year={yearGroup.year} month={monthGroup} anchor lang={lang} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </section>
      )}

      {!era && (
      <div class={showYearNav ? "mt-10" : "mt-6 space-y-12"}>
        {visibleYearGroups.map((yearGroup) => {
          const visibleMonths =
            !renderAllYears && activeMonth
              ? yearGroup.months.filter(
                  (monthGroup) => monthGroup.slug === activeMonth,
                )
              : yearGroup.months

          return (
            <section>
              {intro.length === 0 && (
                <div class="flex items-baseline justify-between gap-4">
                  <YearHeading class="font-display text-ink text-3xl font-medium sm:text-4xl">
                    {heading ?? yearGroup.year}
                  </YearHeading>
                  {heading && <PrintButton lang={lang} />}
                </div>
              )}

              {/* With an intro: the year and its intro in a left column that
                  stays in view, the months beside it on wide screens. */}
              <div class:list={[intro.length > 0 && "lg:grid lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12"]}>
              {intro.length > 0 && (
                <div class="lg:sticky lg:top-24 lg:self-start print:static">
                  <div class="flex items-baseline justify-between gap-4">
                    <YearHeading class="font-display text-ink text-3xl font-medium sm:text-4xl">
                      {heading ?? yearGroup.year}
                    </YearHeading>
                    {heading && <PrintButton lang={lang} />}
                  </div>
                  <div class="border-signal mt-6 max-w-2xl space-y-4 border-l-2 pl-5 lg:max-h-[calc(100vh-13rem)] lg:overflow-y-auto print:max-h-none">
                    <p class="text-signal font-mono text-[10px] tracking-[0.2em] uppercase">
                      {t.yearIntro}
                    </p>
                    {intro.map((paragraph) => (
                      <p class="text-ink leading-7 lg:text-[15px] lg:leading-6">{paragraph}</p>
                    ))}
                  </div>
                </div>
              )}

              <div class="mt-6 min-w-0 space-y-8">
                {visibleMonths.map((monthGroup) => (
                  <TimelineMonth
                    year={yearGroup.year}
                    month={monthGroup}
                    current={!renderAllYears && monthGroup.slug === activeMonth}
                    lang={lang}
                  />
                ))}

                {showBackLink && !renderAllYears && activeMonth && (
                  <div>
                    <a
                      href={to.year(yearGroup.year)}
                      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
                    >
                      {t.backToYear} {yearGroup.year}
                    </a>
                  </div>
                )}
              </div>
              </div>
            </section>
          )
        })}
      </div>
      )}
    </>
  )
}
