---
import PrintButton from "@/components/PrintButton.astro"
import type { Lang } from "@/i18n"
import { paths } from "@/i18n/local"
import type { TimelineYearGroup } from "@/utils/groupTimelineEntries"

// Collection entries (Polish pages) or localised events (src/i18n/local.ts),
// which carry their own href.
type ArchiveEntry = {
  id: string
  href?: string
  data: {
    title: string
    summary: string
    date: Date
    dayOrder?: number
    milestone: boolean
  }
}

interface Props {
  activeYear?: number
  activeMonth?: string
  timelineByYear: TimelineYearGroup<ArchiveEntry>[]
  showYearNav?: boolean
  showBackLink?: boolean
  renderAllYears?: boolean
  // Year and month pages: the year heading becomes the page's <h1> with this
  // text ("1916", "Marzec 1916").
  heading?: string
  // Year pages: "Rok w skrócie", paragraphs shown under the heading.
  intro?: string[]
  lang?: Lang
}

const {
  activeYear,
  activeMonth,
  timelineByYear,
  showYearNav = true,
  showBackLink = true,
  renderAllYears = false,
  heading,
  intro = [],
  lang = "pl",
} = Astro.props
const YearHeading = heading ? "h1" : "h2"
const to = paths(lang)
const t = {
  pl: {
    years: "Lata",
    months: "Miesiące",
    milestone: "Kluczowe wydarzenie",
    backToYear: "wróć do roku",
  },
  en: {
    years: "Years",
    months: "Months",
    milestone: "Key event",
    backToYear: "back to",
  },
}[lang]
const years = timelineByYear.map((yearGroup) => yearGroup.year)
const activeGroup =
  timelineByYear.find((yearGroup) => yearGroup.year === activeYear) ??
  timelineByYear[0]
const visibleYearGroups = renderAllYears
  ? timelineByYear
  : activeGroup
    ? [activeGroup]
    : []

function groupEntriesByDay(
  entries: Props["timelineByYear"][number]["months"][number]["entries"],
) {
  return entries.reduce<Array<{ day: string; entries: typeof entries }>>(
    (groups, entry) => {
      const day = entry.data.date.getUTCDate().toString().padStart(2, "0")
      const lastGroup = groups.at(-1)

      if (lastGroup?.day === day) {
        lastGroup.entries.push(entry)
        return groups
      }

      groups.push({ day, entries: [entry] })
      return groups
    },
    [],
  )
}
---

{
  visibleYearGroups.length > 0 && (
    <>
      {showYearNav && (
        <div class="border-line mt-10 space-y-4 border-b pb-4 font-mono print:hidden">
          <nav
            class="font-display flex flex-wrap gap-x-6 gap-y-2 text-2xl leading-none font-medium sm:gap-x-8 sm:text-3xl"
            aria-label={t.years}
          >
            {years.map((year) => (
              <a
                href={to.year(year)}
                aria-current={
                  year === activeYear && !activeMonth ? "page" : undefined
                }
                class:list={[
                  "transition-colors",
                  year === activeYear
                    ? "text-signal"
                    : "text-ink-soft hover:text-ink",
                ]}
              >
                {year}
              </a>
            ))}
          </nav>

          {activeGroup && (
            <nav
              class="flex flex-wrap items-center gap-x-2 gap-y-2 text-[9px] tracking-[0.2em] uppercase"
              aria-label={`${t.months} ${activeGroup.year}`}
            >
              {activeGroup.months.map((monthGroup, index) => (
                <>
                  {index > 0 && (
                    <span aria-hidden="true" class="text-ink-soft">
                      ·
                    </span>
                  )}
                  <a
                    href={to.month(activeGroup.year, monthGroup.slug)}
                    aria-current={
                      monthGroup.slug === activeMonth ? "page" : undefined
                    }
                    class:list={[
                      "transition-colors",
                      monthGroup.slug === activeMonth
                        ? "text-signal"
                        : "text-ink-soft hover:text-ink",
                    ]}
                  >
                    {monthGroup.label}
                  </a>
                </>
              ))}
            </nav>
          )}
        </div>
      )}

      <div class={showYearNav ? "mt-10" : "mt-6 space-y-12"}>
        {visibleYearGroups.map((yearGroup) => {
          const visibleMonths =
            !renderAllYears && activeMonth
              ? yearGroup.months.filter(
                  (monthGroup) => monthGroup.slug === activeMonth,
                )
              : yearGroup.months

          return (
            <section>
              {intro.length === 0 && (
                <div class="flex items-baseline justify-between gap-4">
                  <YearHeading class="font-display text-ink text-3xl font-medium sm:text-4xl">
                    {heading ?? yearGroup.year}
                  </YearHeading>
                  {heading && <PrintButton lang={lang} />}
                </div>
              )}

              {/* With an intro: the year and its intro in a left column that
                  stays in view, the months beside it on wide screens. */}
              <div class:list={[intro.length > 0 && "lg:grid lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12"]}>
              {intro.length > 0 && (
                <div class="lg:sticky lg:top-24 lg:self-start print:static">
                  <div class="flex items-baseline justify-between gap-4">
                    <YearHeading class="font-display text-ink text-3xl font-medium sm:text-4xl">
                      {heading ?? yearGroup.year}
                    </YearHeading>
                    {heading && <PrintButton lang={lang} />}
                  </div>
                  <div class="border-signal mt-6 max-w-2xl space-y-4 border-l-2 pl-5 lg:max-h-[calc(100vh-13rem)] lg:overflow-y-auto print:max-h-none">
                    <p class="text-signal font-mono text-[10px] tracking-[0.2em] uppercase">
                      {lang === "en" ? "The year in brief" : "Rok w skrócie"}
                    </p>
                    {intro.map((paragraph) => (
                      <p class="text-ink leading-7 lg:text-[15px] lg:leading-6">{paragraph}</p>
                    ))}
                  </div>
                </div>
              )}

              <div class="mt-6 min-w-0 space-y-8">
                {visibleMonths.map((monthGroup) => (
                  <section class="tl-month">
                    {(() => {
                      const dayGroups = groupEntriesByDay(monthGroup.entries)

                      return (
                        <>
                          <h3>
                            <a
                              href={to.month(yearGroup.year, monthGroup.slug)}
                              aria-current={
                                !renderAllYears &&
                                monthGroup.slug === activeMonth
                                  ? "page"
                                  : undefined
                              }
                              class:list={[
                                "font-mono text-[10px] tracking-[0.2em] uppercase transition-colors",
                                !renderAllYears &&
                                monthGroup.slug === activeMonth
                                  ? "text-signal"
                                  : "text-signal hover:text-ink",
                              ]}
                            >
                              {monthGroup.label}
                            </a>
                          </h3>

                          <ul class="border-line mt-3 border-l pl-5">
                            {dayGroups.map((dayGroup) => (
                              <li class="tl-day">
                                <span
                                  aria-hidden="true"
                                  class={
                                    dayGroup.entries.some((entry) => entry.data.milestone)
                                      ? "tl-dot-key"
                                      : "tl-dot"
                                  }
                                />
                                <div class="tl-day-grid">
                                  <span class="tl-day-num">{dayGroup.day}</span>
                                  <div>
                                    <ul>
                                      {dayGroup.entries.map((entry) => (
                                        <li class="tl-entry">
                                          <a
                                            href={entry.href ?? `/${entry.id}`}
                                            class="group block min-w-0"
                                          >
                                            {entry.data.milestone && (
                                              <span class="tl-key-label">{t.milestone}</span>
                                            )}
                                            <span
                                              class={entry.data.milestone ? "tl-title-key" : "tl-title"}
                                            >
                                              {entry.data.title}
                                            </span>
                                            <span class="tl-summary">{entry.data.summary}</span>
                                          </a>
                                        </li>
                                      ))}
                                    </ul>
                                  </div>
                                </div>
                              </li>
                            ))}
                          </ul>
                        </>
                      )
                    })()}
                  </section>
                ))}

                {showBackLink && !renderAllYears && activeMonth && (
                  <div>
                    <a
                      href={to.year(yearGroup.year)}
                      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
                    >
                      {t.backToYear} {yearGroup.year}
                    </a>
                  </div>
                )}
              </div>
              </div>
            </section>
          )
        })}
      </div>
    </>
  )
}
