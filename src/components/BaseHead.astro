---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { SITE } from '@/site.config';
import type { Alternates, Lang } from '@/i18n';
import type { JsonLdNode } from '@/utils/jsonLd';

// Open Graph article metadata (articles and battle pages): og:type becomes
// "article" with article:section, article:tag and article:author.
export interface OgArticle {
  section: string;
  tags: string[];
  // Author page paths (/autor/<slug>, /en/author/<slug>).
  authors: string[];
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: Lang;
  alternates?: Alternates;
  jsonLd?: JsonLdNode[];
  article?: OgArticle;
  // Pages with nothing of their own to index (search results): kept out of
  // search engines, while their links are still followed.
  noindex?: boolean;
}

const { title: pageTitle, description: pageDescription, image, lang = 'pl', alternates = {}, jsonLd, article, noindex = false } = Astro.props;
// One @graph; "<" escaped so text can never close the script tag.
const jsonLdText = jsonLd?.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c')
  : undefined;
// hreflang links only when the page exists in both languages.
const hreflangs = alternates.pl && alternates.en
  ? (['pl', 'en'] as const).map((l) => ({ lang: l, href: new URL(alternates[l]!, Astro.site).href }))
  : [];

// The site name goes after the title only while the whole fits in what
// search results show (about 60 characters); a long title keeps its own words
// visible instead. og:site_name still carries the name.
const MAX_TITLE = 60;
const withSiteName = `${pageTitle} · ${SITE.name}`;
const fullTitle =
  pageTitle.includes(SITE.name) || withSiteName.length > MAX_TITLE ? pageTitle : withSiteName;
const description = pageDescription || SITE.description;
// Static builds give directory-style paths ("/timeline/"); the site uses URLs
// without a trailing slash, so strip it (except for the root "/").
const canonicalPath = Astro.url.pathname.replace(/(.)\/+$/, '$1');
const canonicalURL = new URL(canonicalPath, Astro.site);
const socialImage = new URL(image ?? SITE.ogImage, Astro.site);
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE.name} />

{/* Canonical URL */}
<link rel="canonical" href={canonicalURL} />

{/* Language versions; the redirect script below reads them. */}
{hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
{hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={hreflangs[0].href} />}

{/* Primary Meta Tags */}
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{/* Google Search Console ownership. */}
<meta name="google-site-verification" content="TOHs9lKhnWb8GQrOuX2YVXwFdmr7jwpupI5bqEU6XMQ" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Open Graph / Facebook */}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
{article && <meta property="article:section" content={article.section} />}
{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
{article?.authors.map((path) => <meta property="article:author" content={new URL(path, Astro.site).href} />)}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{/* Structured data */}
{jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}

{/* Favicons */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{/* Optional */}
{/* max-image-preview:large lets Google show large images (Discover, results). */}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<meta name="google-adsense-account" content="ca-pub-5375305864949545" />

{/* Fonts API (Astro 5.x+)*/}
<Font cssVariable="--ff-display" preload />
<Font cssVariable="--ff-body" preload />
<Font cssVariable="--ff-mono" />

{/* Theme Toggle Script */}
<script is:inline>
  // Runs before first paint to avoid a flash of the wrong theme.
  // Kept in sync by ThemeToggle.astro and re-applied after every
  // view-transition navigation below.
  (function () {
    const stored = localStorage.getItem('theme');
    const theme =
      stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
  })();
  document.addEventListener('astro:after-swap', () => {
    const stored = localStorage.getItem('theme');
    const theme =
      stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
  });
</script>

{/* Language redirect */}
<script is:inline>
  // A visitor who chose a language with the switcher is sent to the same page
  // in that language, when it exists. Runs before first paint and after every
  // view-transition navigation.
  (function () {
    function go() {
      var pref;
      try {
        // ?lang=pl or ?lang=en sets the preference (an escape hatch that works
        // even when the stored choice would redirect straight away).
        var forced = new URLSearchParams(location.search).get('lang');
        if (forced === 'pl' || forced === 'en') localStorage.setItem('lang', forced);
        pref = localStorage.getItem('lang');
      } catch (e) { return; }
      if (!pref || pref === document.documentElement.lang) return;
      var alt = document.querySelector('link[rel="alternate"][hreflang="' + pref + '"]');
      if (!alt) return;
      // The alternate links carry the production URL; stay on the current
      // origin (localhost in development) and only swap the path.
      var path = new URL(alt.href).pathname;
      if (path !== location.pathname) location.replace(path + location.search + location.hash);
    }
    go();
    document.addEventListener('astro:after-swap', go);
  })();
</script>

{/* View Transition API */}
<ClientRouter />
