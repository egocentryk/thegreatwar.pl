---
import SectionHeading from "@/components/SectionHeading.astro"
import type { Lang } from "@/i18n"
import { localBattles, paths } from "@/i18n/local"
import { toBattleCard } from "@/utils/battleCard"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const to = paths(lang)
const PICK_COUNT = 3

const battles = await localBattles(lang)

const cards = battles.map((battle) => toBattleCard(battle, lang))

// Build-time pick: shown without JavaScript and replaced on every visit.
const initial = [...cards]
  .sort(() => Math.random() - 0.5)
  .slice(0, PICK_COUNT)

const t = {
  pl: {
    eyebrow: "Bitwy z archiwum",
    lead: "Trzy losowe bitwy z naszej kroniki.",
    shuffle: "Wylosuj inne",
    milestone: "Kluczowe wydarzenie",
    read: "Czytaj →",
    all: "Wszystkie bitwy",
  },
  en: {
    eyebrow: "Battles from the archive",
    lead: "Three battles from the chronicle, picked at random.",
    shuffle: "Pick others",
    milestone: "Key event",
    read: "Read →",
    all: "All battles",
  },
}[lang]
---

<section
  id="bitwy"
  data-random-battles
  data-pool={to.battleCards}
>
  <SectionHeading eyebrow={t.eyebrow} count={battles.length} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <p class="font-display text-ink text-2xl leading-snug text-balance sm:text-3xl">
      {t.lead}
    </p>
    <button
      type="button"
      data-shuffle
      class="border-line text-ink-soft hover:border-signal hover:text-signal inline-flex cursor-pointer items-center gap-2 rounded-sm border px-3 py-2 font-mono text-xs transition-colors"
    >
      <span aria-hidden="true" data-shuffle-icon class="inline-block transition-transform duration-500">↻</span>
      {t.shuffle}
    </button>
  </div>

  <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-1" aria-live="polite">
    {
      initial.map((card) => (
        <li data-card class="min-w-0 transition-opacity duration-300">
          <a
            href={card.href}
            data-href
            class="group border-line bg-surface hover:border-signal flex h-full flex-col rounded-sm border p-5 transition-all hover:-translate-y-0.5"
          >
            <span class="flex items-center justify-between gap-2">
              <span
                data-front
                class="text-signal font-mono text-[10px] tracking-[0.2em] uppercase"
              >
                {card.front}
              </span>
              <span
                data-milestone
                title={t.milestone}
                class:list={[
                  "bg-signal ring-signal/25 size-2 shrink-0 rounded-full ring-4",
                  !card.milestone && "hidden",
                ]}
              />
            </span>

            <span
              data-title
              class="font-display text-ink group-hover:text-signal mt-4 block text-xl leading-snug transition-colors lg:mt-2 lg:text-lg"
            >
              {card.title}
            </span>
            <span data-dates class="text-ink-soft mt-2 block font-mono text-[11px]">
              {card.dates}
            </span>

            <span
              data-summary
              class="text-ink-soft mt-4 line-clamp-5 block text-sm leading-6 lg:hidden"
            >
              {card.summary}
            </span>

            <span class="border-line mt-auto block border-t pt-4 lg:mt-3 lg:pt-3">
              <span data-sides class="text-ink-soft block font-mono text-[11px] leading-5 lg:hidden">
                {card.sides}
              </span>
              <span data-verdict class="text-ink mt-1 block text-sm font-medium">
                {card.verdict}
              </span>
              <span class="text-signal mt-3 inline-block font-mono text-xs transition-transform group-hover:translate-x-1">
                {t.read}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-6">
    <a
      href={to.battles}
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      {t.all} ({battles.length}) →
    </a>
  </div>
</section>

<script>
  import type { BattleCard as Card } from "@/utils/battleCard"

  // Fetched once per page load from a static file the browser caches.
  const pools = new Map<string, Promise<Card[]>>()
  function loadPool(url: string) {
    if (!pools.has(url)) {
      pools.set(
        url,
        fetch(url)
          .then((response) => (response.ok ? response.json() : []))
          .catch(() => []),
      )
    }
    return pools.get(url)!
  }

  // Pick `count` different battles, avoiding the ones already on screen when possible.
  function pick(cards: Card[], count: number, exclude: Set<string>) {
    const fresh = cards.filter((card) => !exclude.has(card.href))
    const pool = fresh.length >= count ? fresh : cards
    const copy = [...pool]
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[copy[i], copy[j]] = [copy[j], copy[i]]
    }
    return copy.slice(0, count)
  }

  function fill(item: Element, card: Card) {
    const set = (selector: string, text: string) => {
      const el = item.querySelector(selector)
      if (el) el.textContent = text
    }
    item.querySelector<HTMLAnchorElement>("[data-href]")?.setAttribute("href", card.href)
    set("[data-front]", card.front)
    set("[data-title]", card.title)
    set("[data-dates]", card.dates)
    set("[data-summary]", card.summary)
    set("[data-sides]", card.sides)
    set("[data-verdict]", card.verdict)
    item.querySelector("[data-milestone]")?.classList.toggle("hidden", !card.milestone)
  }

  function initRandomBattles() {
    const section = document.querySelector("[data-random-battles]")
    const url = section?.getAttribute("data-pool")
    if (!section || !url) return
    const items = [...section.querySelectorAll("[data-card]")]
    const current = () =>
      new Set(
        items.map((item) => item.querySelector("[data-href]")?.getAttribute("href") ?? ""),
      )

    const show = async (animate: boolean) => {
      const cards = await loadPool(url)
      if (cards.length < items.length) return
      const picks = pick(cards, items.length, current())
      if (!animate) {
        items.forEach((item, i) => fill(item, picks[i]))
        return
      }
      items.forEach((item) => item.classList.add("opacity-0"))
      window.setTimeout(() => {
        items.forEach((item, i) => {
          fill(item, picks[i])
          item.classList.remove("opacity-0")
        })
      }, 300)
    }

    show(false)

    let turns = 0
    const button = section.querySelector("[data-shuffle]")
    const icon = section.querySelector<HTMLElement>("[data-shuffle-icon]")
    button?.addEventListener("click", () => {
      turns += 1
      if (icon) icon.style.transform = `rotate(${turns * 360}deg)`
      show(true)
    })
  }

  // astro:page-load fires on the first load and after every client-side navigation.
  document.addEventListener("astro:page-load", initRandomBattles)
</script>
