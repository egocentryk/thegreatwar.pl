---
import Button from "@/components/Button.astro"
import CoffeeIcon from "@/components/CoffeeIcon.astro"
import type { Lang } from "@/i18n"
import { SITE } from "@/site.config"

interface Props {
  lang?: Lang
  class?: string
}

const { lang = "pl", class: className } = Astro.props
---

<!-- Floats right inside a prose block so the text wraps around it. -->
<div class:list={["not-prose float-right mb-2 ml-4 sm:mb-3 sm:ml-6 print:hidden", className]}>
  <Button href={SITE.support} variant="accent" size="responsive" target="_blank" rel="noopener noreferrer">
    <CoffeeIcon class="size-3.5 sm:size-4" />
    {lang === "en" ? "Buy us a coffee" : "Kup nam kawę"}
  </Button>
</div>
