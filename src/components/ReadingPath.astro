---
import SectionHeading from "@/components/SectionHeading.astro"
import { READING_PATH } from "@/data/homepage"
import { locale, type Lang } from "@/i18n"
import { READING_PATH_EN } from "@/i18n/data-en"
import { curated } from "@/i18n/local"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { readingMinutes } from "@/utils/requireEntry"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const loc = locale(lang)
const steps = await Promise.all(
  READING_PATH.map(async (step) => {
    const item = await curated(lang, step.collection, step.slug)
    const battle = step.collection === "battles"
    return {
      kind: battle
        ? lang === "en" ? "Battle" : "Bitwa"
        : lang === "en" ? "Event" : "Wydarzenie",
      href: item.href,
      title: item.title,
      pl: item.pl,
      when: battle
        ? formatDateRange(item.date, item.endDate, loc)
        : formatDate(item.date, "long", undefined, loc),
      minutes: readingMinutes(item.body),
      note: lang === "en" ? (READING_PATH_EN[step.slug] ?? step.note) : step.note,
    }
  }),
)

const totalMinutes = steps.reduce((sum, step) => sum + step.minutes, 0)

const t = {
  pl: {
    eyebrow: "Od czego zacząć",
    lead: (n: number) => `Cała wojna w ${n} tekstach.`,
    reading: (min: number) => `ok. ${min} min czytania`,
  },
  en: {
    eyebrow: "Where to start",
    lead: (n: number) => `The whole war in ${n} articles.`,
    reading: (min: number) => `about ${min} min of reading`,
  },
}[lang]
---

<section id="od-czego-zaczac" class="mx-auto max-w-3xl px-6 pb-20">
  <SectionHeading eyebrow={t.eyebrow} count={steps.length} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <p class="font-display text-ink max-w-md text-2xl leading-snug sm:text-3xl">
      {t.lead(steps.length)}
    </p>
    <p class="text-ink-soft font-mono text-xs">
      {t.reading(Math.round(totalMinutes / 5) * 5)}
    </p>
  </div>

  <ol class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
    {
      steps.map((step, index) => (
        <li class="min-w-0">
          <a
            href={step.href}
            hreflang={step.pl ? "pl" : undefined}
            class="group border-line bg-surface hover:border-signal relative flex h-full gap-4 overflow-hidden rounded-sm border p-5 transition-all hover:-translate-y-0.5"
          >
            <span
              class="font-display text-ink/[0.05] group-hover:text-signal/15 pointer-events-none absolute -right-1 -bottom-6 text-8xl leading-none font-medium transition-colors select-none"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="text-signal shrink-0 pt-0.5 font-mono text-xs">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="relative min-w-0">
              <span class="text-ink-soft flex flex-wrap gap-x-2 font-mono text-[10px] tracking-[0.15em] uppercase">
                <span>{step.kind}</span>
                <span aria-hidden="true">·</span>
                <span>{step.minutes} min</span>
              </span>
              <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg leading-snug transition-colors">
                {step.title}
                {step.pl && <span class="lang-mark">(PL)</span>}
              </span>
              <span class="text-ink-soft mt-1 block font-mono text-[11px]">
                {step.when}
              </span>
              <span class="text-ink-soft mt-3 block text-sm leading-6">
                {step.note}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
