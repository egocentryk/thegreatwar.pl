---
import { Image } from "astro:assets"
import SectionHeading from "@/components/SectionHeading.astro"
import { READING_PATH } from "@/data/homepage"
import { locale, type Lang } from "@/i18n"
import { READING_PATH_EN } from "@/i18n/data-en"
import { curated } from "@/i18n/local"
import { articleImage } from "@/utils/articleImages"
import { formatDate, formatDateRange } from "@/utils/formatDate"
import { readingMinutes } from "@/utils/requireEntry"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const loc = locale(lang)
const steps = await Promise.all(
  READING_PATH.map(async (step) => {
    const item = await curated(lang, step.collection, step.slug)
    const battle = step.collection === "battles"
    return {
      kind: battle
        ? lang === "en" ? "Battle" : "Bitwa"
        : lang === "en" ? "Event" : "Wydarzenie",
      href: item.href,
      title: item.title,
      pl: item.pl,
      when: battle
        ? formatDateRange(item.date, item.endDate, loc)
        : formatDate(item.date, "long", undefined, loc),
      minutes: readingMinutes(item.body),
      // Cover photo from the article's own image (utils/articleImages.ts).
      image: articleImage(battle ? `bitwy/${step.slug}` : step.slug),
      note: lang === "en" ? (READING_PATH_EN[step.slug] ?? step.note) : step.note,
    }
  }),
)

const totalMinutes = steps.reduce((sum, step) => sum + step.minutes, 0)

const t = {
  pl: {
    eyebrow: "Od czego zacząć",
    lead: (n: number) => `Cała wojna w ${n} tekstach.`,
    reading: (min: number) => `ok. ${min} min czytania`,
  },
  en: {
    eyebrow: "Where to start",
    lead: (n: number) => `The whole war in ${n} articles.`,
    reading: (min: number) => `about ${min} min of reading`,
  },
}[lang]
---

<section id="od-czego-zaczac">
  <SectionHeading eyebrow={t.eyebrow} count={steps.length} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <p class="font-display text-ink text-2xl leading-snug text-balance sm:text-3xl">
      {t.lead(steps.length)}
    </p>
    <p class="text-ink-soft font-mono text-xs">
      {t.reading(Math.round(totalMinutes / 5) * 5)}
    </p>
  </div>

  {/* Covers: the article's photo in black and white under a dark gradient,
      or a typographic cover when it has none. Always dark, in both themes. */}
  <ol class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {
      steps.map((step, index) => (
        <li class="min-w-0">
          <a
            href={step.href}
            hreflang={step.pl ? "pl" : undefined}
            class="group relative flex min-h-64 flex-col justify-end lg:aspect-[3/4] overflow-hidden rounded-sm bg-[#16171c] text-white"
          >
            {step.image ? (
              <Image
                src={step.image.asset}
                alt=""
                widths={[320, 480, 640].filter((w) => w <= step.image!.asset.width)}
                sizes="(min-width: 1024px) 270px, 50vw"
                class="absolute inset-0 size-full object-cover opacity-70 grayscale transition duration-500 group-hover:scale-105 group-hover:opacity-85"
              />
            ) : (
              <span
                class="font-display absolute -top-4 -right-2 text-[11rem] leading-none font-medium text-white/[0.06] transition-colors select-none group-hover:text-white/10"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
            )}
            <span class="absolute inset-0 bg-linear-to-t from-black/90 via-black/45 to-black/10" aria-hidden="true" />

            <span class="relative p-4 sm:p-5">
              <span class="font-display block text-4xl leading-none font-medium text-white/90">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="mt-3 flex flex-wrap gap-x-2 font-mono text-[10px] tracking-[0.15em] text-white/60 uppercase">
                <span>{step.kind}</span>
                <span aria-hidden="true">·</span>
                <span>{step.minutes} min</span>
              </span>
              <span class="font-display mt-1 block text-lg leading-snug transition-colors group-hover:text-[#b9b9ff] sm:text-xl">
                {step.title}
                {step.pl && <span class="lang-mark">(PL)</span>}
              </span>
              <span class="mt-1 block font-mono text-[11px] text-white/60">{step.when}</span>
              <span class="mt-2 line-clamp-2 hidden text-xs leading-5 text-white/70 sm:block">{step.note}</span>
              {step.image && !/public domain|domena|cc0/i.test(step.image.license) && (
                <span class="mt-2 block truncate font-mono text-[9px] text-white/40">
                  {lang === "en" ? "Photo" : "Fot."} {step.image.author} · {step.image.license}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
