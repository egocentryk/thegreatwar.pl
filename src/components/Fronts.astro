---
import SectionHeading from "@/components/SectionHeading.astro"
import { FRONT_NOTES } from "@/data/homepage"
import { frontEn, plural, type Lang } from "@/i18n"
import { FRONT_NOTES_EN } from "@/i18n/data-en"
import { localBattles, localEvents, paths } from "@/i18n/local"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const to = paths(lang)
const entries = await localEvents(lang)
const battles = await localBattles(lang)

// One column per war year.
const COLUMNS = [1914, 1915, 1916, 1917, 1918].map((year) => ({
  label: String(year),
  test: (y: number) => y === year,
}))

const fronts = Object.entries(FRONT_NOTES).map(([front, note]) => {
  const frontEntries = entries.filter((entry) => entry.data.frontKey === front)
  const perColumn = COLUMNS.map(
    (column) => frontEntries.filter((entry) => column.test(entry.data.date.getUTCFullYear())).length,
  )
  return {
    front: lang === "en" ? frontEn(front) : front,
    note: lang === "en" ? (FRONT_NOTES_EN[front] ?? note) : note,
    href: to.front(front),
    anchor: to.frontAnchor(front),
    eventCount: frontEntries.length,
    battleCount: battles.filter((battle) => battle.data.frontKey === front).length,
    perColumn,
  }
  // The English page lists only fronts with something translated.
}).filter((front) => lang === "pl" || front.eventCount > 0)
// One scale for the whole table; the square root keeps quiet years visible.
const busiest = Math.max(...fronts.flatMap((front) => front.perColumn))
const shade = (count: number) => (count ? Math.round(12 + Math.sqrt(count / busiest) * 88) : 0)

const t = {
  pl: {
    eyebrow: "Fronty",
    lead: "Wojna na wszystkich kontynentach i morzach.",
    front: "Front",
    events: "Wydarzenia",
    battles: "Bitwy",
    less: "mniej",
    more: "więcej",
    cell: (front: string, year: string, n: number) => `${front}, ${year}: ${n} ${plural("pl", n, ["wydarzenie", "wydarzenia", "wydarzeń"], ["", ""])}`,
  },
  en: {
    eyebrow: "Fronts",
    lead: "War on every continent and ocean.",
    front: "Front",
    events: "Events",
    battles: "Battles",
    less: "fewer",
    more: "more",
    cell: (front: string, year: string, n: number) => `${front}, ${year}: ${n} ${plural("en", n, ["", "", ""], ["event", "events"])}`,
  },
}[lang]
---

<section id="fronty">
  <SectionHeading eyebrow={t.eyebrow} count={fronts.length} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <p class="font-display text-ink text-2xl leading-snug text-balance sm:text-3xl">
      {t.lead}
    </p>
    <p class="text-ink-soft flex items-center gap-1.5 font-mono text-[10px]" aria-hidden="true">
      {t.less}
      {[0.15, 0.35, 0.6, 1].map((level) => (
        <span class="size-3 rounded-[2px]" style={`background: color-mix(in oklab, var(--signal) ${Math.round(level * 100)}%, transparent)`} />
      ))}
      {t.more}
    </p>
  </div>

  {/* Fronts × years: each cell shaded by the number of events that year. */}
  <div class="-mx-6 mt-8 overflow-x-auto px-6">
    <table class="w-full min-w-[38rem] table-fixed border-separate border-spacing-1 text-left">
      <colgroup>
        <col class="w-44 lg:w-72" />
        {COLUMNS.map(() => <col />)}
        <col class="w-24" />
        <col class="w-16" />
      </colgroup>
      <thead>
        <tr class="text-ink-soft font-mono text-[10px] tracking-[0.1em] uppercase">
          <th scope="col" class="pb-2 font-normal">{t.front}</th>
          {COLUMNS.map((column) => <th scope="col" class="pb-2 text-center font-normal">{column.label}</th>)}
          <th scope="col" class="pb-2 pl-3 text-right font-normal">{t.events}</th>
          <th scope="col" class="pb-2 pl-3 text-right font-normal">{t.battles}</th>
        </tr>
      </thead>
      <tbody>
        {
          fronts.map((front) => (
            <tr class="group">
              <th scope="row" class="pr-4 font-normal">
                <a href={front.href} title={front.note} class="block py-1">
                  <span class="font-display text-ink group-hover:text-signal block leading-snug transition-colors">{front.front}</span>
                  <span class="text-ink-soft hidden truncate text-[11px] leading-4 lg:block">{front.note}</span>
                </a>
              </th>
              {front.perColumn.map((count, index) => (
                <td class="p-0">
                  {count ? (
                    <a
                      href={front.href}
                      title={t.cell(front.front, COLUMNS[index].label, count)}
                      aria-label={t.cell(front.front, COLUMNS[index].label, count)}
                      class:list={[
                        "flex h-10 items-center justify-center rounded-[3px] font-mono text-[11px] tabular-nums transition-[filter] hover:brightness-110",
                        shade(count) > 55 ? "text-white" : "text-ink",
                      ]}
                      style={`background: color-mix(in oklab, var(--signal) ${shade(count)}%, transparent)`}
                    >
                      {count}
                    </a>
                  ) : (
                    <span class="border-line block h-10 rounded-[3px] border border-dashed" aria-hidden="true" />
                  )}
                </td>
              ))}
              <td class="pl-3 text-right font-mono text-xs">
                <a href={front.href} class="text-signal hover:underline">{front.eventCount}</a>
              </td>
              <td class="pl-3 text-right font-mono text-xs">
                {front.battleCount > 0 ? (
                  <a href={`${to.battles}#${front.anchor}`} class="text-ink-soft hover:text-signal transition-colors">
                    {front.battleCount}
                  </a>
                ) : (
                  <span class="text-ink-soft">–</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
