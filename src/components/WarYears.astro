---
import SectionHeading from "@/components/SectionHeading.astro"
import { WAR_YEARS } from "@/data/homepage"
import { locale, plural, type Lang } from "@/i18n"
import { WAR_YEARS_EN } from "@/i18n/data-en"
import { curated, localBattles, localEvents, paths } from "@/i18n/local"
import { getTimelineMonthSlug } from "@/utils/groupTimelineEntries"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const to = paths(lang)
const entries = await localEvents(lang)
const battles = await localBattles(lang)
const years = new Set(entries.map((entry) => entry.data.date.getUTCFullYear()))

const monthNames = new Intl.DateTimeFormat(locale(lang), {
  month: "long",
  timeZone: "UTC",
})

// Events per month of each year, for the bar strip on every card.
const perMonth = new Map<string, number>()
for (const entry of entries) {
  const d = entry.data.date
  const key = `${d.getUTCFullYear()}-${d.getUTCMonth()}`
  perMonth.set(key, (perMonth.get(key) ?? 0) + 1)
}
// One scale for all five years, so busy and quiet months compare honestly.
const busiest = Math.max(...perMonth.values())

const cards = await Promise.all(
  WAR_YEARS.map(async ({ year, summary, highlights }) => {
    const months = Array.from({ length: 12 }, (_, month) => {
      const count = perMonth.get(`${year}-${month}`) ?? 0
      return {
        count,
        href: to.month(year, getTimelineMonthSlug(month)),
        label: `${monthNames.format(new Date(Date.UTC(year, month, 1)))} ${year}`,
        // Square root keeps quiet months visible next to August 1914.
        height: count
          ? Math.max(8, Math.round(Math.sqrt(count / busiest) * 100))
          : 0,
      }
    })
    const eventCount = entries.filter(
      (entry) => entry.data.date.getUTCFullYear() === year,
    ).length
    const battleCount = battles.filter(
      (battle) => battle.data.startDate.getUTCFullYear() === year,
    ).length
    return {
      year,
      // A year with nothing translated yet links to the Polish year.
      href: years.has(year) ? to.year(year) : paths("pl").year(year),
      pl: !years.has(year),
      summary: lang === "en" ? (WAR_YEARS_EN[year] ?? summary) : summary,
      months,
      eventCount,
      battleCount,
      highlights: await Promise.all(
        highlights.map((slug) => curated(lang, "timeline", slug)),
      ),
    }
  }),
)

const t = {
  pl: {
    eyebrow: "Lata wojny",
    lead: "Pięć lat, od Sarajewa po rozejm.",
    perMonth: (year: number) => `Liczba wydarzeń w kolejnych miesiącach ${year} roku`,
    initials: "SLMKMCLSWPLG",
  },
  en: {
    eyebrow: "The war years",
    lead: "Five years, from Sarajevo to the Armistice.",
    perMonth: (year: number) => `Number of events in each month of ${year}`,
    initials: "JFMAMJJASOND",
  },
}[lang]
---

<section id="lata-wojny">
  <SectionHeading eyebrow={t.eyebrow} count={cards.length} />

  <p class="font-display text-ink text-2xl leading-snug text-balance sm:text-3xl">
    {t.lead}
  </p>

  {/* One card per year; the war's five years fit one row on wide screens. */}
  <ol class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
    {
      cards.map((y) => (
        <li class="group/year border-line bg-surface hover:border-signal flex min-w-0 flex-col rounded-sm border p-5 transition-colors">
          <div class="flex items-end justify-between gap-3">
            <a
              href={y.href}
              hreflang={y.pl && lang === "en" ? "pl" : undefined}
              class="font-display text-ink group-hover/year:text-signal text-5xl leading-none font-medium tracking-tight transition-colors"
            >
              {y.year}
            </a>
            <p class="text-ink-soft text-right font-mono text-[10px] leading-4">
              {y.eventCount}{" "}
              {plural(lang, y.eventCount, ["wydarzenie", "wydarzenia", "wydarzeń"], ["event", "events"])}
              <br />
              {y.battleCount}{" "}
              {plural(lang, y.battleCount, ["bitwa", "bitwy", "bitew"], ["battle", "battles"])}
            </p>
          </div>

          <p class="text-ink-soft mt-4 line-clamp-4 text-sm leading-6">{y.summary}</p>

          <ul class="mt-4 space-y-1.5">
            {y.highlights.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  hreflang={entry.pl ? "pl" : undefined}
                  class="text-ink hover:text-signal flex items-baseline gap-2 text-xs leading-5 transition-colors"
                >
                  <span class="bg-signal size-1.5 shrink-0 -translate-y-px rounded-full" aria-hidden="true" />
                  <span>
                    {entry.title}
                    {entry.pl && <span class="lang-mark">(PL)</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-5">
            <div class="flex h-10 items-end gap-0.5" aria-label={t.perMonth(y.year)}>
              {y.months.map((m) =>
                m.count ? (
                  <a
                    href={m.href}
                    title={`${m.label}: ${m.count}`}
                    aria-label={`${m.label}: ${m.count}`}
                    class="bg-ink/25 hover:bg-signal! group-hover/year:bg-signal/50 block flex-1 rounded-t-xs transition-colors"
                    style={`height: ${m.height}%`}
                  />
                ) : (
                  <span class="border-line block h-px flex-1 border-t border-dashed" aria-hidden="true" />
                ),
              )}
            </div>
            <div class="text-ink-soft mt-1 flex gap-0.5 font-mono text-[8px] uppercase" aria-hidden="true">
              {t.initials.split("").map((letter) => (
                <span class="flex-1 text-center">{letter}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
