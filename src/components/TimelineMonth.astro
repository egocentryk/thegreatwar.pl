---
import type { Lang } from "@/i18n"
import { paths } from "@/i18n/local"
import type { ArchiveEntry, TimelineMonthGroup } from "@/utils/groupTimelineEntries"

// One month of the timeline: its heading (a link to the month page) and its
// days. Used by TimelineArchive.astro.
interface Props {
  year: number
  month: TimelineMonthGroup<ArchiveEntry>
  // The month page itself: its heading is marked as the current page.
  current?: boolean
  // On the era page the month is an anchor (paths().month links "#1908-10").
  anchor?: boolean
  lang?: Lang
}

const { year, month, current = false, anchor = false, lang = "pl" } = Astro.props
const to = paths(lang)
const milestoneLabel = lang === "en" ? "Key event" : "Kluczowe wydarzenie"

const dayGroups = month.entries.reduce<Array<{ day: string; entries: ArchiveEntry[] }>>((groups, entry) => {
  const day = entry.data.date.getUTCDate().toString().padStart(2, "0")
  const lastGroup = groups.at(-1)

  if (lastGroup?.day === day) {
    lastGroup.entries.push(entry)
    return groups
  }

  groups.push({ day, entries: [entry] })
  return groups
}, [])
---

<section class="tl-month" id={anchor ? `${year}-${month.slug}` : undefined}>
  <h3>
    <a
      href={to.month(year, month.slug)}
      aria-current={current ? "page" : undefined}
      class:list={[
        "text-signal font-mono text-[10px] tracking-[0.2em] uppercase transition-colors",
        !current && "hover:text-ink",
      ]}
    >
      {month.label}
    </a>
  </h3>

  <ul class="border-line mt-3 border-l pl-5">
    {dayGroups.map((dayGroup) => (
      <li class="tl-day">
        <span
          aria-hidden="true"
          class={dayGroup.entries.some((entry) => entry.data.milestone) ? "tl-dot-key" : "tl-dot"}
        />
        <div class="tl-day-grid">
          <span class="tl-day-num">{dayGroup.day}</span>
          <div>
            <ul>
              {dayGroup.entries.map((entry) => (
                <li class="tl-entry">
                  <a href={entry.href ?? `/${entry.id}`} class="group block min-w-0">
                    {entry.data.milestone && <span class="tl-key-label">{milestoneLabel}</span>}
                    <span class={entry.data.milestone ? "tl-title-key" : "tl-title"}>{entry.data.title}</span>
                    <span class="tl-summary">{entry.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
