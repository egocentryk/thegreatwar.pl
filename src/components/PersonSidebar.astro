---
// Right-hand column of a person page on wide screens (lg+): the portrait with
// its credit, the facts, the battles the person commanded, the people who
// appear beside them most, and the support card. On smaller screens the page
// keeps the portrait and facts above the text and the lists below it, so this
// column is hidden there.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import SidebarSupport from "@/components/SidebarSupport.astro"
import type { Lang } from "@/i18n"

interface Props {
  lang?: Lang
  name: string
  photo?: { src: ImageMetadata; credit: string; license: string; source: string }
  facts: { label: string; value: string }[]
  battles: { href: string; title: string; when: string; pl?: boolean }[]
  coPeople: { href: string; name: string; count: number; photo?: ImageMetadata; pl?: boolean }[]
}

const { lang = "pl", name, photo, facts, battles, coPeople } = Astro.props
const SHOWN = 6

const t = {
  pl: {
    photo: "Fot.",
    battles: "Dowodził w bitwach",
    co: "Najczęściej obok",
    all: (n: number) => `wszystkie (${n}) ↓`,
    anchor: "#dowodzil",
  },
  en: {
    photo: "Photo:",
    battles: "Commanded in battles",
    co: "Most often alongside",
    all: (n: number) => `all (${n}) ↓`,
    anchor: "#commanded",
  },
}[lang]
const block = "border-line border-t pt-5"
const label = "text-ink-soft font-mono text-[10px] tracking-[0.2em] uppercase"
---

<aside class="hidden space-y-8 pt-10 lg:block print:hidden">
  <div class="border-line overflow-hidden rounded-sm border">
    {
      photo && (
        <figure class="border-line border-b">
          <Image
            src={photo.src}
            alt={name}
            widths={[320, 480, 640]}
            sizes="380px"
            loading="eager"
            class="aspect-[3/4] w-full object-cover"
          />
          <figcaption class="text-ink-soft px-4 py-2 font-mono text-[10px] leading-4">
            {t.photo}{" "}
            <a href={photo.source} rel="noopener" class="hover:text-signal transition-colors">
              {photo.credit}, {photo.license}, Wikimedia Commons
            </a>
          </figcaption>
        </figure>
      )
    }
    <dl class="divide-line divide-y text-sm">
      {
        facts.map((fact) => (
          <div class="px-4 py-3">
            <dt class={label}>{fact.label}</dt>
            <dd class="text-ink mt-1 text-[13px] leading-5">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  {
    battles.length > 0 && (
      <div class={block}>
        <p class={label}>{t.battles}</p>
        <ul class="mt-3 space-y-3">
          {battles.slice(0, SHOWN).map((battle) => (
            <li>
              <a href={battle.href} hreflang={battle.pl ? "pl" : undefined} class="group block">
                <span class="text-ink group-hover:text-signal block text-sm leading-snug transition-colors">
                  {battle.title}
                  {battle.pl && <span class="lang-mark">(PL)</span>}
                </span>
                <span class="text-ink-soft block font-mono text-[10px]">{battle.when}</span>
              </a>
            </li>
          ))}
        </ul>
        {battles.length > SHOWN && (
          <a href={t.anchor} class="text-ink-soft hover:text-signal mt-3 inline-block font-mono text-[10px] transition-colors">
            {t.all(battles.length)}
          </a>
        )}
      </div>
    )
  }

  {
    coPeople.length > 0 && (
      <div class={block}>
        <p class={label}>{t.co}</p>
        <ul class="mt-3 space-y-3">
          {coPeople.slice(0, SHOWN).map((other) => (
            <li>
              <a href={other.href} hreflang={other.pl ? "pl" : undefined} class="group flex items-center gap-3">
                {other.photo ? (
                  <Image
                    src={other.photo}
                    alt=""
                    width={80}
                    height={80}
                    class="border-line size-10 shrink-0 rounded-full border object-cover object-top"
                  />
                ) : (
                  <span class="border-line bg-surface text-ink-soft font-display flex size-10 shrink-0 items-center justify-center rounded-full border text-sm">
                    {other.name.charAt(0)}
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="text-ink group-hover:text-signal block truncate text-sm leading-snug transition-colors">
                    {other.name}
                    {other.pl && <span class="lang-mark">(PL)</span>}
                  </span>
                </span>
                <span class="text-ink-soft font-mono text-[10px]">{other.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <SidebarSupport lang={lang} />
</aside>
