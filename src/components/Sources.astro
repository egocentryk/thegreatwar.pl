---
// The pages an article was researched from (`sources:` in its front matter,
// e.g. added by scripts/person-sources.mjs). Shows nothing when there are none.
import type { Lang } from "@/i18n"

interface Props {
  sources: string[]
  lang?: Lang
}

const { sources, lang = "pl" } = Astro.props

// "Battle of Jutland · Wikipedia (en)", "naval-history.net · xDKBritishNavy1914".
function label(href: string) {
  const url = new URL(href)
  const host = url.hostname.replace(/^www\./, "")
  const wiki = host.match(/^([a-z-]+)\.wikipedia\.org$/)
  const last = decodeURIComponent(url.pathname.split("/").filter(Boolean).pop() ?? "")
  if (wiki && url.pathname.startsWith("/wiki/")) return `${last.replace(/_/g, " ")} · Wikipedia (${wiki[1]})`
  const page = last.replace(/\.(html?|php|aspx?|pdf)$/i, "").replace(/[-_]+/g, " ").trim()
  return /[a-z]/i.test(page) && !/^(index|default|main)$/i.test(page) ? `${host} · ${page}` : host
}
// Labels that repeat in one list show the whole path instead.
const labels = sources.map(label)
const shown = sources.map((href, i) =>
  labels.indexOf(labels[i]) === labels.lastIndexOf(labels[i]) ? labels[i] : href.replace(/^https?:\/\/(www\.)?/, ""),
)
---

{
  sources.length > 0 && (
    <section class="border-line mt-12 max-w-2xl border-t pt-6">
      <h2 class="text-ink-soft font-mono text-[10px] tracking-[0.2em] uppercase">
        {lang === "en" ? "Sources" : "Źródła"}
      </h2>
      <ol class="mt-3 space-y-1.5 text-sm">
        {sources.map((href, i) => (
          <li class="text-ink-soft min-w-0 wrap-break-word">
            <a href={href} rel="noopener nofollow" target="_blank" class="hover:text-signal transition-colors">
              {shown[i]}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
