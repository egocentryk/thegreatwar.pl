---
// "Wesprzyj kronikę": the support card after an article on screens without
// the sidebar (the sidebar has its own card that stays in view).
import Button from "@/components/Button.astro"
import CoffeeIcon from "@/components/CoffeeIcon.astro"
import type { Lang } from "@/i18n"
import { SITE } from "@/site.config"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props

const t = {
  pl: {
    title: "Ta kronika jest bezpłatna i bez reklam.",
    text: "Każdy tekst powstaje na podstawie kilku źródeł, ze sprawdzonymi datami i liczbami. Jeśli ten był dla Ciebie wartościowy, możesz wesprzeć pisanie kolejnych.",
    button: "Kup nam kawę",
  },
  en: {
    title: "This chronicle is free and has no ads.",
    text: "Every text is written from several sources, with dates and figures checked. If this one was useful to you, you can support the next ones.",
    button: "Buy us a coffee",
  },
}[lang]
---

<aside class="border-signal/40 bg-surface mt-12 max-w-2xl rounded-sm border p-5 sm:flex sm:items-center sm:gap-6 print:hidden">
  <div class="min-w-0 flex-1">
    <p class="font-display text-ink text-lg leading-snug">{t.title}</p>
    <p class="text-ink-soft mt-1.5 text-sm leading-6">{t.text}</p>
  </div>
  <Button href={SITE.support} variant="accent" target="_blank" rel="noopener noreferrer" class="mt-4 shrink-0 sm:mt-0">
    <CoffeeIcon />
    {t.button}
  </Button>
</aside>
