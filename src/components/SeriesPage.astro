---
// One themed series (data/series.ts): intro, the overview text, and every
// step as a numbered mini timeline grouped by year. Used by /serie/<slug>
// and /en/series/<slug>.
import BaseLayout from "@/layouts/BaseLayout.astro"
import PrintButton from "@/components/PrintButton.astro"
import type { Series } from "@/data/series"
import { plural, type Lang } from "@/i18n"
import { paths } from "@/i18n/local"
import { listPageLd } from "@/utils/jsonLd"
import { allSeries, resolveSeries } from "@/utils/series"

interface Props {
  series: Series
  lang?: Lang
}

const { series: source, lang = "pl" } = Astro.props
const to = paths(lang)
const series = await resolveSeries(source, lang)
const others = (await allSeries(lang)).filter((item) => item.slug !== series.slug)
const byYear = [...new Set(series.steps.map((step) => step.year))].map((year) => ({
  year,
  steps: series.steps.flatMap((step, index) => (step.year === year ? [{ ...step, number: index + 1 }] : [])),
}))
const count = series.steps.length + (series.overview ? 1 : 0)

const t = {
  pl: {
    all: "← Wszystkie serie",
    eyebrow: "Seria",
    reading: (min: number) => `ok. ${min} min czytania`,
    overview: "Całość w jednym tekście",
    battle: "Bitwa",
    event: "Wydarzenie",
    key: "Kluczowe",
    more: "Inne serie",
  },
  en: {
    all: "← All series",
    eyebrow: "Series",
    reading: (min: number) => `about ${min} min of reading`,
    overview: "The whole story in one article",
    battle: "Battle",
    event: "Event",
    key: "Key moment",
    more: "Other series",
  },
}[lang]
const texts = plural(lang, count, ["tekst", "teksty", "tekstów"], ["article", "articles"])

const jsonLd = listPageLd(Astro.site!, {
  lang,
  path: series.href,
  name: series.title,
  description: series.lead,
  trail: [{ name: lang === "en" ? "Series" : "Serie", path: to.series }],
  items: [...(series.overview ? [series.overview.href] : []), ...series.steps.map((step) => step.href)],
})
---

<BaseLayout
  jsonLd={jsonLd}
  title={lang === "en" ? `${series.title}: a reading series` : `${series.title} – seria artykułów`}
  description={`${series.lead} ${series.intro}`.slice(0, 155).replace(/\s+\S*$/, "…")}
  lang={lang}
  alternates={lang === "en" ? { pl: series.alternate } : { en: series.alternate }}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <a href={to.series} class="text-ink-soft hover:text-signal font-mono text-xs transition-colors print:hidden">{t.all}</a>

    <p class="text-signal mt-6 font-mono text-[10px] tracking-[0.2em] uppercase">{t.eyebrow}</p>
    <h1 class="font-display text-ink mt-3 text-3xl font-medium sm:text-4xl">{series.title}</h1>
    <p class="text-ink-soft mt-2 font-mono text-xs">
      {series.years} · {count} {texts} · {t.reading(Math.round(series.minutes / 5) * 5)}
    </p>
    <p class="text-ink mt-6 max-w-2xl leading-7">{series.intro}</p>
    <div class="mt-6">
      <PrintButton lang={lang} />
    </div>

    {
      series.overview && (
        <a
          href={series.overview.href}
          hreflang={series.overview.pl ? "pl" : undefined}
          class="group border-line bg-surface hover:border-signal mt-8 block rounded-sm border p-5 transition-colors"
        >
          <span class="text-signal font-mono text-[10px] tracking-[0.15em] uppercase">
            {t.overview} · {series.overview.minutes} min
          </span>
          <span class="font-display text-ink group-hover:text-signal mt-1 block text-lg leading-snug transition-colors">
            {series.overview.title}
            {series.overview.pl && <span class="lang-mark">(PL)</span>}
          </span>
          <span class="text-ink-soft mt-1 block font-mono text-[11px]">{series.overview.when}</span>
          <span class="text-ink-soft mt-2 block text-sm leading-6">{series.overview.summary}</span>
        </a>
      )
    }

    <div class="mt-12 space-y-10">
      {
        byYear.map((group) => (
          <section>
            <h2 class="font-display text-ink text-2xl font-medium">{group.year}</h2>
            <ol class="border-line mt-4 border-t">
              {group.steps.map((step) => (
                <li class="border-line hover:border-signal border-b transition-colors">
                  <a
                    href={step.href}
                    hreflang={step.pl ? "pl" : undefined}
                    class="group grid grid-cols-[2rem_1fr] gap-x-3 py-4 sm:grid-cols-[2rem_10rem_1fr] sm:gap-x-4"
                  >
                    <span class="text-signal font-mono text-xs leading-6">{String(step.number).padStart(2, "0")}</span>
                    <span class="text-ink-soft col-start-2 font-mono text-xs leading-6 sm:col-start-auto">{step.when}</span>
                    <span class="col-start-2 min-w-0 sm:col-start-auto">
                      <span class="text-ink-soft mb-1 flex flex-wrap gap-x-2 font-mono text-[9px] tracking-[0.2em] uppercase">
                        <span>{step.battle ? t.battle : t.event}</span>
                        {step.milestone && (
                          <>
                            <span aria-hidden="true">·</span>
                            <span class="text-signal">{t.key}</span>
                          </>
                        )}
                        <span aria-hidden="true">·</span>
                        <span>{step.minutes} min</span>
                      </span>
                      <span class="text-ink group-hover:text-signal block transition-colors">
                        {step.title}
                        {step.pl && <span class="lang-mark">(PL)</span>}
                      </span>
                      {step.note && (
                        <span class="text-ink border-signal mt-1.5 block border-l-2 pl-2 text-sm leading-6">{step.note}</span>
                      )}
                      <span class="text-ink-soft mt-1 block text-[11px] leading-5 sm:text-xs">{step.summary}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    {
      others.length > 0 && (
        <nav class="border-line mt-16 border-t pt-6 print:hidden" aria-label={t.more}>
          <p class="text-ink-soft font-mono text-[10px] tracking-[0.2em] uppercase">{t.more}</p>
          <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
            {others.map((item) => (
              <li>
                <a href={item.href} class="text-ink-soft hover:text-signal transition-colors">
                  {item.title} →
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </section>
</BaseLayout>
