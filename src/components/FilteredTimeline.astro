---
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { locale, type Lang } from "@/i18n"
import { localPeople, paths } from "@/i18n/local"
import { counterpart, isThin, LABELS, yearLinks, type Group, type Kind } from "@/utils/filteredPages"
import { groupTimelineEntries, WAR_START_YEAR } from "@/utils/groupTimelineEntries"
import { listPageLd } from "@/utils/jsonLd"
import { listMeta } from "@/utils/periodMeta"
import { getPeople, personByName } from "@/utils/people"

// Timeline page for a single tag, category, author or front, in either
// language (utils/filteredPages.ts). Long lists are split by year: `year` is
// set on <base>/<year> pages.
interface Props {
  kind: Kind
  group: Group
  year?: number
  lang?: Lang
}

const { kind, group, year, lang = "pl" } = Astro.props
const { name, entries, base } = group
const label = LABELS[kind][lang]
const years = yearLinks(entries, base)
const activeYear = years ? (year ?? years[0].year) : undefined
const timelineByYear = groupTimelineEntries(entries, locale(lang)).filter(
  (yearGroup) => activeYear === undefined || Math.max(yearGroup.year, WAR_START_YEAR) === activeYear,
)
const shown = timelineByYear.flatMap((yearGroup) => yearGroup.months.flatMap((month) => month.entries))
// Count, years and key events (utils/periodMeta.ts): of the whole list on its
// main page, of the year on a year page.
const { description } = year
  ? listMeta(lang, kind, name, shown, String(year))
  : listMeta(lang, kind, name, entries)
// Small tag pages stay out of search engines (utils/filteredPages.ts).
const noindex = isThin(kind, group)
// A tag that names a person leads to the person page: English if translated.
const personId = kind === "tag" ? personByName(await getPeople(), group.key)?.id : undefined
const person = personId
  ? ((await localPeople(lang)).find((p) => p.id === personId) ??
    (await localPeople("pl")).find((p) => p.id === personId))
  : undefined
const title = `${label}: ${name}${year ? ` (${year})` : ""}`
// In search results the subject and the war say more than "Tag:": "Kamerun –
// I wojna światowa", "Cameroon in the First World War". Author pages keep
// their label.
const subject = `${name.charAt(0).toUpperCase()}${name.slice(1)}${year ? ` (${year})` : ""}`
const pageTitle =
  kind === "author" ? title : lang === "en" ? `${subject} in the First World War` : `${subject} – I wojna światowa`
// The same list in the other language, when it exists.
const other = await counterpart(kind, lang, group.key, year)
const alternates = other ? { [lang === "pl" ? "en" : "pl"]: other } : undefined
// Structured data: the list as a collection of its articles; a year page sits
// under the main list in the breadcrumbs (utils/jsonLd.ts).
const pagePath = Astro.url.pathname.replace(/(.)\/+$/, "$1")
const jsonLd = listPageLd(Astro.site!, {
  lang,
  path: pagePath,
  name: title,
  description,
  trail: year ? [{ name: `${label}: ${name}`, path: base }] : [],
  items: shown.map((entry) => entry.href),
})
---

<BaseLayout
  jsonLd={jsonLd}
  noindex={noindex}
  title={pageTitle}
  description={description}
  lang={lang}
  alternates={alternates}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
    <a
      href={paths(lang).timeline}
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      {lang === "en" ? "← Timeline" : "← Oś czasu"}
    </a>

    <h1
      class="font-display text-ink mt-6 mb-10 text-3xl font-medium sm:text-4xl"
    >
      {name}
    </h1>

    {
      person && (
        <a href={person.href} class="text-signal -mt-7 mb-10 block w-fit font-mono text-xs hover:underline">
          {lang === "en" ? "Person page" : "Strona postaci"}: {person.data.name} →
        </a>
      )
    }

    <SectionHeading eyebrow={label} count={entries.length} />
    {
      years && (
        <nav
          class="border-line font-display -mt-2 mb-10 flex flex-wrap gap-x-6 gap-y-3 border-b pb-4 text-2xl leading-none font-medium sm:gap-x-8 sm:text-3xl"
          aria-label={lang === "en" ? "Years" : "Lata"}
        >
          {years.map((link) => (
            <a
              href={link.href}
              aria-current={link.year === activeYear ? "page" : undefined}
              class:list={[
                "transition-colors",
                link.year === activeYear ? "text-signal" : "text-ink-soft hover:text-ink",
              ]}
            >
              {link.year}
              <span class="ml-1 align-super font-mono text-[10px] font-normal">{link.count}</span>
            </a>
          ))}
        </nav>
      )
    }
    <TimelineArchive
      timelineByYear={timelineByYear}
      renderAllYears={true}
      showYearNav={false}
      showBackLink={false}
      lang={lang}
    />
  </section>
</BaseLayout>
