---
import type { CollectionEntry } from "astro:content"
import TimelineArchive from "@/components/TimelineArchive.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { locale, type Alternates, type Lang } from "@/i18n"
import { paths, type LocalEvent } from "@/i18n/local"
import { groupTimelineEntries } from "@/utils/groupTimelineEntries"

// Timeline page for a single tag, category or front.
interface Props {
  label: string
  name: string
  entries: (CollectionEntry<"timeline"> | LocalEvent)[]
  lang?: Lang
  alternates?: Alternates
}

const { label, name, entries, lang = "pl", alternates } = Astro.props
const timelineByYear = groupTimelineEntries(entries, locale(lang))
const description =
  lang === "en"
    ? `Events – ${label.toLowerCase()}: ${name}.`
    : `Wydarzenia — ${label.toLowerCase()}: ${name}.`
---

<BaseLayout
  title={`${label}: ${name}`}
  description={description}
  lang={lang}
  alternates={alternates}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <a
      href={paths(lang).timeline}
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      {lang === "en" ? "← Timeline" : "← Oś czasu"}
    </a>

    <h1
      class="font-display text-ink mt-6 mb-10 text-3xl font-medium sm:text-4xl"
    >
      {name}
    </h1>

    <SectionHeading eyebrow={label} count={entries.length} />
    <TimelineArchive
      timelineByYear={timelineByYear}
      renderAllYears={true}
      showYearNav={false}
      showBackLink={false}
      lang={lang}
    />
  </section>
</BaseLayout>
