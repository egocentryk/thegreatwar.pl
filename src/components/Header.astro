---
import ThemeToggle from '@/components/ThemeToggle.astro';
import LangSwitch from '@/components/LangSwitch.astro';
import CoffeeIcon from '@/components/CoffeeIcon.astro';
import { SITE, NAV_LINKS, NAV_LINKS_EN, GUIDE, GUIDE_EN } from '@/site.config';
import type { Alternates, Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  alternates?: Alternates;
}

const { lang = 'pl', alternates = {} } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const links = (lang === 'en' ? NAV_LINKS_EN : NAV_LINKS).map((link) => ({ ...link, isActive: isActive(link.href) }));
const contact = lang === 'en' ? { label: 'Contact', href: '/en#contact' } : { label: 'Kontakt', href: '/#contact' };
const guideSource = lang === 'en' ? GUIDE_EN : GUIDE;
const guide = {
  label: guideSource.label,
  items: guideSource.items.map((link) => ({ ...link, isActive: isActive(link.href) })),
  more: guideSource.more.map((link) => ({ ...link, isActive: isActive(link.href) })),
};
const guideActive = [...guide.items, ...guide.more].some((link) => link.isActive);
const homeHref = lang === 'en' ? '/en' : '/';
const menuLabels = lang === 'en' ? { open: 'Open menu', close: 'Close menu' } : { open: 'Otwórz menu', close: 'Zamknij menu' };
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href={homeHref} class="font-display text-ink text-lg font-medium">
      {SITE.name}
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
      {/* Desktop: links inline */}
      <nav class="hidden items-center gap-5 lg:flex" aria-label="Primary">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={link.isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                link.isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <div class="relative" data-guide>
          <button
            type="button"
            data-guide-toggle
            aria-expanded="false"
            aria-controls="guide-panel"
            class:list={[
              'flex cursor-pointer items-center gap-1 font-mono text-xs tracking-wide uppercase transition-colors',
              guideActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
            ]}
          >
            {guide.label}
            <svg
              data-guide-chevron
              class="h-3 w-3 transition-transform duration-200 motion-reduce:transition-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          {/* Opens below the header, right-aligned to the button; hidden while closed. */}
          <div
            id="guide-panel"
            data-guide-panel
            hidden
            class="border-line bg-paper absolute top-full right-0 mt-5 w-[34rem] border shadow-lg"
          >
            <ul class="grid grid-cols-2 gap-px p-2">
              {
                guide.items.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.isActive ? 'page' : undefined}
                      class="group hover:bg-line/40 block px-4 py-3 transition-colors"
                    >
                      <span
                        class:list={[
                          'font-display block text-base transition-colors',
                          link.isActive ? 'text-signal' : 'text-ink group-hover:text-signal',
                        ]}
                      >
                        {link.label}
                      </span>
                      <span class="text-ink-soft mt-0.5 block text-xs leading-5">{link.note}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <ul class="border-line flex flex-wrap gap-x-5 gap-y-2 border-t px-6 py-4">
              {
                guide.more.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.isActive ? 'page' : undefined}
                      class:list={[
                        'font-mono text-[11px] tracking-wide uppercase transition-colors',
                        link.isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <a href={contact.href} class="text-ink-soft hover:text-ink font-mono text-xs tracking-wide uppercase transition-colors">
          {contact.label}
        </a>
      </nav>

      <a
        href={SITE.support}
        target="_blank"
        rel="noopener noreferrer"
        title={lang === 'en' ? 'Buy us a coffee' : 'Kup nam kawę'}
        aria-label={lang === 'en' ? 'Buy us a coffee' : 'Kup nam kawę'}
        class="bg-signal hover:bg-ink hover:text-paper flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white transition-colors"
      >
        <CoffeeIcon class="h-4 w-4" />
      </a>
      <LangSwitch lang={lang} alternates={alternates} />
      <ThemeToggle />

      {/* Mobile: hamburger toggles the panel below */}
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={menuLabels.open}
        data-label-open={menuLabels.open}
        data-label-close={menuLabels.close}
        class="text-ink-soft hover:border-signal hover:text-signal border-line flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border transition-colors lg:hidden"
      >
        <svg
          data-menu-icon-open
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          data-menu-icon-close
          class="hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* Slides open by animating the grid row from 0fr to 1fr; inert while closed. */}
  <div
    id="mobile-menu"
    data-menu-panel
    data-open="false"
    inert
    class="group grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] motion-reduce:transition-none lg:hidden"
  >
    <nav aria-label="Primary" class="overflow-hidden">
      <ul
        class="border-line bg-paper mx-auto max-w-6xl -translate-y-2 border-t px-6 py-2 opacity-0 transition duration-300 ease-out group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100 motion-reduce:transition-none"
      >
        {
          links.map((link) => (
            <li class="border-line border-b last:border-b-0">
              <a
                href={link.href}
                aria-current={link.isActive ? 'page' : undefined}
                class:list={[
                  'block py-4 font-mono text-sm tracking-wide uppercase transition-colors',
                  link.isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="border-line border-b py-4">
          <p class:list={['font-mono text-sm tracking-wide uppercase', guideActive ? 'text-signal' : 'text-ink-soft']}>
            {guide.label}
          </p>
          <ul class="mt-2 grid grid-cols-2 gap-x-4">
            {
              guide.items.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.isActive ? 'page' : undefined}
                    class:list={[
                      'font-display block py-2 text-base transition-colors',
                      link.isActive ? 'text-signal' : 'text-ink hover:text-signal',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
            {
              guide.more.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.isActive ? 'page' : undefined}
                    class:list={[
                      'block py-1 font-mono text-[11px] tracking-wide uppercase transition-colors',
                      link.isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li>
          <a href={contact.href} class="text-ink-soft hover:text-ink block py-4 font-mono text-sm tracking-wide uppercase transition-colors">
            {contact.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Document-level listeners from the previous page are dropped on each navigation.
  let controller: AbortController | undefined;

  function initMobileMenu() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const button = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!button || !panel) return;

    const iconOpen = button.querySelector('[data-menu-icon-open]');
    const iconClose = button.querySelector('[data-menu-icon-close]');

    const isOpen = () => panel.dataset.open === 'true';
    const setOpen = (open: boolean) => {
      panel.dataset.open = String(open);
      panel.inert = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => setOpen(!isOpen()), { signal });
    panel.addEventListener(
      'click',
      (event) => {
        if ((event.target as HTMLElement).closest('a')) setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
    // Close when the viewport grows to the desktop layout (Tailwind `lg`).
    window
      .matchMedia('(min-width: 64rem)')
      .addEventListener('change', (event) => event.matches && setOpen(false), { signal });
    document.addEventListener(
      'click',
      (event) => {
        const target = event.target as Node;
        if (isOpen() && !panel.contains(target) && !button.contains(target)) {
          setOpen(false);
        }
      },
      { signal },
    );
  }

  // The desktop "Przewodnik" dropdown: opens on click, closes on a link, an
  // outside click or Escape.
  function initGuide() {
    const root = document.querySelector<HTMLElement>('[data-guide]');
    const button = root?.querySelector<HTMLButtonElement>('[data-guide-toggle]');
    const panel = root?.querySelector<HTMLElement>('[data-guide-panel]');
    if (!root || !button || !panel || !controller) return;
    const { signal } = controller;
    const chevron = button.querySelector('[data-guide-chevron]');

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    button.addEventListener('click', () => setOpen(!isOpen()), { signal });
    panel.addEventListener('click', (event) => (event.target as HTMLElement).closest('a') && setOpen(false), { signal });
    document.addEventListener(
      'click',
      (event) => isOpen() && !root.contains(event.target as Node) && setOpen(false),
      { signal },
    );
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
  }

  // astro:page-load fires on the first load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => {
    initMobileMenu();
    initGuide();
  });
</script>
