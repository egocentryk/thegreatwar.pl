---
// Hover previews of people: a link to a person page inside the text
// ([data-glossary-scope]) shows a card with the portrait, name, years and
// role on hover or focus; on touch screens the first tap opens the card and
// its link leads on. The page passes its markdown body; only the people it
// links are sent. Without JavaScript the links simply work as links.
import { getImage } from "astro:assets"
import type { Lang } from "@/i18n"
import { localPeople } from "@/i18n/local"

interface Props {
  body: string
  lang?: Lang
}

const { body, lang = "pl" } = Astro.props
const ids = [...new Set([...body.matchAll(/\]\(\/postacie\/([a-z0-9-]+)\)/g)].map((m) => m[1]))]
const local = new Map((await localPeople(lang)).map((p) => [p.id, p]))
const pl = new Map((await localPeople("pl")).map((p) => [p.id, p]))

const people = (
  await Promise.all(
    ids.map(async (id) => {
      // English pages link the Polish page when there is no translation.
      const person = local.get(id) ?? pl.get(id)
      if (!person) return undefined
      const d = person.source.data
      const photo = d.photo ? await getImage({ src: d.photo.src, width: 112, height: 112, fit: "cover", position: "top" }) : undefined
      return {
        href: person.href,
        name: person.data.name,
        years: `${d.born.getUTCFullYear()}–${d.died.getUTCFullYear()}`,
        role: person.data.role,
        photo: photo?.src,
      }
    }),
  )
).filter((p) => p !== undefined)
const more = lang === "en" ? "Biography →" : "Biogram →"
---

{
  people.length > 0 && (
    <script type="application/json" data-person-previews data-more={more} set:html={JSON.stringify(people)} />
  )
}

<script>
  interface Person {
    href: string
    name: string
    years: string
    role: string
    photo?: string
  }

  let card: HTMLElement | undefined
  let hideTimer: number | undefined

  function show(link: HTMLAnchorElement, person: Person, more: string) {
    window.clearTimeout(hideTimer)
    if (!card) {
      card = Object.assign(document.createElement("div"), { className: "person-card", role: "tooltip" })
      card.addEventListener("mouseenter", () => window.clearTimeout(hideTimer))
      card.addEventListener("mouseleave", hide)
    }
    if (!card.isConnected) document.body.append(card)
    card.replaceChildren()
    if (person.photo) {
      const img = Object.assign(document.createElement("img"), { src: person.photo, alt: "", className: "person-card-photo" })
      card.append(img)
    }
    const text = document.createElement("div")
    text.append(
      Object.assign(document.createElement("p"), { className: "person-card-name", textContent: person.name }),
      Object.assign(document.createElement("p"), { className: "person-card-years", textContent: person.years }),
      Object.assign(document.createElement("p"), { className: "person-card-role", textContent: person.role }),
      Object.assign(document.createElement("a"), { className: "person-card-more", href: person.href, textContent: more }),
    )
    card.append(text)
    card.dataset.for = person.href
    card.hidden = false
    const r = link.getBoundingClientRect()
    const width = Math.min(340, window.innerWidth - 32)
    card.style.width = `${width}px`
    card.style.left = `${Math.max(16, Math.min(r.left + window.scrollX, window.scrollX + window.innerWidth - width - 16))}px`
    card.style.top = `${r.bottom + window.scrollY + 8}px`
  }

  function hide() {
    hideTimer = window.setTimeout(() => {
      if (card) card.hidden = true
    }, 150)
  }

  function init() {
    const data = document.querySelector<HTMLScriptElement>("[data-person-previews]")
    const scope = document.querySelector<HTMLElement>("[data-glossary-scope]")
    if (!data || !scope) return
    const people: Person[] = JSON.parse(data.textContent ?? "[]")
    const more = data.dataset.more ?? "→"
    const byHref = new Map(people.map((p) => [p.href, p]))
    const touch = window.matchMedia("(hover: none)").matches
    scope.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      const person = byHref.get(link.getAttribute("href") ?? "")
      if (!person) return
      link.addEventListener("mouseenter", () => show(link, person, more))
      link.addEventListener("mouseleave", hide)
      link.addEventListener("focus", () => show(link, person, more))
      link.addEventListener("blur", hide)
      if (touch)
        link.addEventListener("click", (event) => {
          if (card?.hidden === false && card.dataset.for === person.href) return
          event.preventDefault()
          show(link, person, more)
        })
    })
    document.addEventListener("click", (event) => {
      const target = event.target as Element
      if (card && !card.hidden && !card.contains(target) && !byHref.has(target.closest("a")?.getAttribute("href") ?? ""))
        card.hidden = true
    })
  }

  document.addEventListener("astro:page-load", init)
</script>

<style is:global>
  .person-card {
    position: absolute;
    z-index: 50;
    display: flex;
    gap: 0.875rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    padding: 0.875rem;
    box-shadow: 0 10px 30px -12px color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .person-card-photo {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    object-fit: cover;
  }
  .person-card-name {
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.3;
  }
  .person-card-years {
    margin-top: 0.125rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .person-card-role {
    margin-top: 0.375rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .person-card-more {
    display: inline-block;
    margin-top: 0.375rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
</style>
