---
import SectionHeading from "@/components/SectionHeading.astro"
import { POLISH_THREAD } from "@/data/homepage"
import { locale, plural, type Lang } from "@/i18n"
import { curated, localEvents } from "@/i18n/local"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const TAG = "Polska"

const dayMonth = new Intl.DateTimeFormat(locale(lang), {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
})

const steps = (
  await Promise.all(POLISH_THREAD.map((slug) => curated(lang, "timeline", slug)))
)
  .sort((a, b) => a.date.valueOf() - b.date.valueOf())
  .map((entry) => ({
    href: entry.href,
    title: entry.title,
    summary: entry.summary,
    pl: entry.pl,
    day: dayMonth.format(entry.date),
    year: entry.date.getUTCFullYear(),
    milestone: entry.milestone,
  }))

// Events tagged "Polska" in this language; the link leads to its tag page.
const tagged = (await localEvents(lang)).filter((entry) =>
  entry.data.tags.includes(TAG),
).length

const t = {
  pl: {
    eyebrow: "Polska w Wielkiej Wojnie",
    lead: "Od trzech zaborów do niepodległości.",
    intro:
      "Front wschodni przetoczył się przez ziemie polskie, a Polacy walczyli w trzech armiach zaborców i we własnych formacjach. Wojna, która zaczęła się bez Polski, skończyła się jej odrodzeniem.",
    all: `Wszystkie ${tagged} ${plural(lang, tagged, ["wydarzenie", "wydarzenia", "wydarzeń"], ["", ""])} z tagiem „${TAG}” →`,
  },
  en: {
    eyebrow: "Poland in the Great War",
    lead: "From three partitions to independence.",
    intro:
      "The Eastern Front rolled across Polish lands, and Poles fought in the three armies of the partitioning powers and in formations of their own. A war that began without Poland ended with its rebirth.",
    all: `All ${tagged} events tagged “Poland” →`,
  },
}[lang]
import { listUrl } from "@/utils/filteredPages"
---

<section id="polska">
  <SectionHeading eyebrow={t.eyebrow} count={steps.length} />

  <div class="border-line bg-surface relative overflow-hidden rounded-sm border">
    <span
      class="bg-signal absolute inset-y-0 left-0 w-1"
      aria-hidden="true"
    ></span>

    <div class="p-6 sm:p-8">
      <p class="font-display text-ink text-2xl leading-snug sm:text-3xl">
        {t.lead}
      </p>
      <p class="text-ink-soft mt-3 max-w-lg text-sm leading-6">
        {t.intro}
      </p>

      <ol class="mt-8">
        {
          steps.map((step, index) => (
            <li class="group relative grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 pb-6 last:pb-0 sm:grid-cols-[6rem_minmax(0,1fr)]">
              {index < steps.length - 1 && (
                <span
                  class="bg-line absolute top-4 -bottom-1.5 left-[calc(5.5rem+5px)] w-px sm:left-[calc(7rem+5px)]"
                  aria-hidden="true"
                />
              )}
              <span class="pt-0.5 text-right font-mono leading-tight">
                <span class="text-ink block text-xs">{step.year}</span>
                <span class="text-ink-soft block text-[10px]">{step.day}</span>
              </span>
              <a
                href={step.href}
                hreflang={step.pl ? "pl" : undefined}
                class="relative block pl-5"
              >
                <span
                  class:list={[
                    "absolute top-1.5 left-0 z-10 size-[11px] rounded-full border-2 transition-colors",
                    step.milestone
                      ? "bg-signal border-signal"
                      : "bg-surface border-ink/30 group-hover:border-signal",
                  ]}
                  aria-hidden="true"
                />
                <span class="text-ink group-hover:text-signal block leading-snug transition-colors">
                  {step.title}
                  {step.pl && <span class="lang-mark">(PL)</span>}
                </span>
                <span class="text-ink-soft mt-1 line-clamp-2 block text-xs leading-5">
                  {step.summary}
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <a
        href={listUrl("tag", lang, TAG)}
        class="text-signal mt-6 block font-mono text-xs hover:underline"
      >
        {t.all}
      </a>
    </div>
  </div>
</section>
