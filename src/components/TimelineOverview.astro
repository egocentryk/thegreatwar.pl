---
// The whole timeline, opened at its first war year. Used by /timeline and /en/timeline.
import SectionHeading from "@/components/SectionHeading.astro"
import TimelineArchive from "@/components/TimelineArchive.astro"
import { locale, type Lang } from "@/i18n"
import { localEvents } from "@/i18n/local"
import { groupTimelineEntries, isPreWar } from "@/utils/groupTimelineEntries"

interface Props {
  lang?: Lang
}

const { lang = "pl" } = Astro.props
const allTimeline = await localEvents(lang)
const timelineByYear = groupTimelineEntries(allTimeline, locale(lang))
// The years before the war have their own page, "Przed wojną".
const defaultYear = timelineByYear.find((group) => !isPreWar(group.year))?.year
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-24 sm:pt-24">
  <SectionHeading
    eyebrow={lang === "en" ? "The full timeline" : "Pełna linia czasu"}
    count={allTimeline.length}
    level={1}
  />
  <p class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs">
    <a href={lang === "en" ? "/en/key-dates" : "/najwazniejsze-daty"} class="text-signal hover:underline">
      {lang === "en" ? "Key dates on one page →" : "Najważniejsze daty na jednej stronie →"}
    </a>
    <a href={lang === "en" ? "/en/topics" : "/tematy"} class="text-ink-soft hover:text-signal transition-colors">
      {lang === "en" ? "Topics: the big questions →" : "Tematy: najważniejsze pytania →"}
    </a>
    <a href={lang === "en" ? "/en/countries" : "/kraje"} class="text-ink-soft hover:text-signal transition-colors">
      {lang === "en" ? "Countries at war →" : "Kraje w wojnie →"}
    </a>
  </p>
  {
    defaultYear && (
      <TimelineArchive
        activeYear={defaultYear}
        timelineByYear={timelineByYear}
        lang={lang}
      />
    )
  }
</section>
