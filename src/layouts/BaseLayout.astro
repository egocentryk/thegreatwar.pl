---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import type { Alternates, Lang } from '@/i18n';
import type { JsonLdNode } from '@/utils/jsonLd';
import type { OgArticle } from '@/components/BaseHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Page language and its counterpart in the other language, if any.
  lang?: Lang;
  alternates?: Alternates;
  // schema.org nodes for this page (utils/jsonLd.ts).
  jsonLd?: JsonLdNode[];
  // Articles and battle pages: Open Graph article metadata.
  article?: OgArticle;
  // Search results: noindex, follow (BaseHead.astro).
  noindex?: boolean;
}

// `image` is only set by article pages with an image; other pages fall back to SITE.ogImage.
const { title, description, image, lang = 'pl', alternates = {}, jsonLd, article, noindex } = Astro.props;
const pageDescription = description ?? (lang === 'en' ? SITE.descriptionEn : SITE.description);
// Every page lists itself under its own language.
const selfPath = Astro.url.pathname.replace(/(.)\/+$/, '$1');
const allAlternates: Alternates = { ...alternates, [lang]: selfPath };
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={pageDescription} image={image} lang={lang} alternates={allAlternates} jsonLd={jsonLd} article={article} noindex={noindex} />
  </head>
  <body id="top" class="bg-paper text-ink">
    <Header lang={lang} alternates={allAlternates} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
